+#ifdef __APPLE__
+/* Ambre : un Mac déclare une vingtaine d'interfaces internes (AirDrop awdl, llw, anpi, tunnels
+ * utun d'iCloud, gif, stf, pont Thunderbolt, point d'accès ap, nan...). Un PC Windows n'en a que
+ * deux ou trois, et des programmes n'en regardent que les premières : Steam ne lit que 10
+ * cartes (rangées dans un ordre quelconque) et, faute d'y trouver la carte connectée, attend
+ * 20 s le réseau au démarrage. On ne présente donc ces interfaces internes que si elles ont
+ * une adresse IPv4 (un VPN, par exemple). Les vraies cartes (en*) et lo0 restent visibles. */
+BOOL ambre_hidden_interface( const char *name, struct ifaddrs *addrs )
+{
+    static const char * const prefixes[] =
+        { "awdl", "llw", "anpi", "utun", "gif", "stf", "bridge", "ap", "nan", "ipsec" };
+    struct ifaddrs *ifa;
+    unsigned int i;
+    size_t len;
+
+    for (i = 0; i < ARRAY_SIZE(prefixes); i++)
+    {
+        len = strlen( prefixes[i] );
+        if (!strncmp( name, prefixes[i], len ) && name[len] >= '0' && name[len] <= '9') break;
+    }
+    if (i == ARRAY_SIZE(prefixes)) return FALSE;
+    for (ifa = addrs; ifa; ifa = ifa->ifa_next)
+        if (ifa->ifa_addr && ifa->ifa_addr->sa_family == AF_INET && !strcmp( ifa->ifa_name, name ))
+            return FALSE;
+    return TRUE;
+}
+#endif
+
