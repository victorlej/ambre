     if (!indices)
@@ -321,10 +358,16 @@ static unsigned int update_if_table( void )
 
     for (entry = indices; entry->if_index; entry++)
     {
+#ifdef __APPLE__
+        if (ambre_hidden_interface( entry->if_name, addrs )) continue;
+#endif
         if (!find_entry_from_index( entry->if_index ) && add_entry( entry->if_index, entry->if_name ))
             ++append_count;
     }
 
+#ifdef __APPLE__
+    if (addrs) freeifaddrs( addrs );
+#endif
     if_freenameindex( indices );
     return append_count;
 }
