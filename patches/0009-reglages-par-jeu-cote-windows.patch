     FILE *f;
 
     if (!dir || dir[0] != '/' || !image_path) return;
@@ -741,8 +742,18 @@ static void ambre_game_env( const char *image_path )
         *eq = 0;
         if (eq[1]) setenv( line, eq + 1, 1 );
         else unsetenv( line );
+        /* Ambre : noms retenus pour l'environnement Windows du jeu (voir ambre_game_env_windows
