+        len = strlen( line );
+        if (used + len + 2 < sizeof(names))
+        {
+            if (used) names[used++] = ':';
+            memcpy( names + used, line, len + 1 );
+            used += len;
+        }
     }
     fclose( f );
+    if (used) setenv( "AMBRE_GAME_ENV_NAMES", names, 1 );
 }
 
