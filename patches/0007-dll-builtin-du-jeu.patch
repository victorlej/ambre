diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
index 84db441..e27aa90 100644
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -1634,6 +1634,35 @@ NTSTATUS load_builtin( struct pe_mapping_info *pe_mapping, USHORT machine,
     if (pe_mapping->image.wine_builtin)
     {
         if (loadorder == LO_NATIVE) return STATUS_DLL_NOT_FOUND;
+        /* Ambre : une DLL « builtin » posée dans le dossier d'un programme (hors dossiers système)
+         * est chargée telle quelle si AMBRE_LOCAL_BUILTINS est posé. Allia met ainsi DXMT (Metal
+         * direct, livré en DLL builtin) à côté d'un jeu, pour ce jeu seulement ; sinon Wine chargeait
+         * à la place ses propres d3d11/dxgi (wined3d) et le jeu n'avait jamais DXMT. */
+        if (!is_system_dir && getenv( "AMBRE_LOCAL_BUILTINS" ))
+        {
+            /* Jamais sous C:\windows (pilotes de system32\drivers compris, que Wine ne compte pas
+             * comme dossier système : le 29 sept., ils se chargeaient ainsi et Steam perdait le
+             * réseau) : seulement dans les dossiers des programmes. */
+            static const char windows_dir[] = "\\windows\\";
+            const WCHAR *name = pe_mapping->nt_name.Buffer;
+            USHORT i, j, len = pe_mapping->nt_name.Length / sizeof(WCHAR);
+            BOOL in_windows = FALSE;
+            for (i = 0; !in_windows && i + 9 <= len; i++)
+            {
+                for (j = 0; j < 9; j++)
+                {
+                    WCHAR c = name[i + j];
+                    if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+                    if (c != (WCHAR)windows_dir[j]) break;
+                }
+                if (j == 9) in_windows = TRUE;
+            }
+            if (!in_windows)
+            {
+                TRACE( "%s : DLL builtin du programme, chargée telle quelle\n", debugstr_us(&pe_mapping->nt_name) );
+                return STATUS_IMAGE_ALREADY_LOADED;
+            }
+        }
         loadorder = LO_BUILTIN_NATIVE;  /* load builtin, then fallback to the file we found */
     }
     else if (pe_mapping->image.wine_fakedll)
