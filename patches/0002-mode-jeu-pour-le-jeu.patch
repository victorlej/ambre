         wineloader = build_path( ntdll_dir, "wine" );
     }
 
+    /* Ambre : lancer les nouveaux programmes par le chemin indiqué (le lien
+     * « Allia Jeu.app/Contents/MacOS/wine »), pour que macOS les rattache à
+     * l'app « Allia Jeu », déclarée comme jeu : Mode Jeu pour le jeu lui-même.
