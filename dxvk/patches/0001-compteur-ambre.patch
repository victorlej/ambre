+  void HudFrameStatsItem::update(dxvk::high_resolution_clock::time_point time) {
+    auto frameUs = std::chrono::duration_cast<std::chrono::microseconds>(time - m_lastFrame).count();
+    m_lastFrame = time;
+
+    // Une pause de plus d'une seconde (chargement, jeu en arriere-plan) ne compte pas.
+    if (frameUs > 0 && frameUs < 1'000'000) {
+      m_lastMs = float(frameUs) / 1000.0f;
+      m_frameTimes[m_next] = m_lastMs;
+      m_next = (m_next + 1) % HistorySize;
+      m_count = std::min(m_count + 1, HistorySize);
+    }
+
+    auto elapsed = std::chrono::duration_cast<std::chrono::microseconds>(time - m_lastUpdate);
+
+    if (elapsed.count() >= UpdateInterval && m_count > 0) {
+      std::vector<float> times(m_frameTimes.begin(), m_frameTimes.begin() + m_count);
+      std::sort(times.begin(), times.end(), std::greater<float>());
+
+      float total = 0.0f;
+      for (float t : times)
+        total += t;
+
+      auto lowFps = [&times] (size_t permille) {
+        size_t n = std::max<size_t>(1, times.size() * permille / 1000);
+        float sum = 0.0f;
+        for (size_t i = 0; i < n; i++)
+          sum += times[i];
+        return 1000.0f * float(n) / sum;
+      };
+
+      m_average = ambreFormat(1000.0f * float(times.size()) / total, 1);
+      m_low1    = ambreFormat(lowFps(10), 1);
+      m_low01   = ambreFormat(lowFps(1), 1);
+      m_frameMs = ambreFormat(m_lastMs, 1);
+      m_lastUpdate = time;
+    }
+  }
+
+
+  HudPos HudFrameStatsItem::render(
+          HudRenderer&      renderer,
+          HudPos            position) {
+    const HudColor label = { 1.0f, 0.72f, 0.25f, 1.0f };
+    const HudColor value = { 1.0f, 1.0f, 1.0f, 1.0f };
+
+    const std::pair<const char*, const std::string*> lines[] = {
+      { "Images/s",       &m_average },
+      { "1% bas",         &m_low1    },
+      { "0,1% bas",       &m_low01   },
+      { "Temps d'image",  &m_frameMs },
+    };
+
+    for (const auto& line : lines) {
+      position.y += 16.0f;
+      renderer.drawText(16.0f, { position.x, position.y }, label, line.first);
+      renderer.drawText(16.0f, { position.x + 150.0f, position.y }, value,
+        line.second == &m_frameMs ? *line.second + " ms" : *line.second);
+      position.y += 4.0f;
+    }
+
+    position.y += 4.0f;
+    return position;
+  }
+
+
+  HudCpuItem::HudCpuItem() { }
+
+  HudCpuItem::~HudCpuItem() { }
+
+
+  void HudCpuItem::update(dxvk::high_resolution_clock::time_point time) {
+    auto elapsed = std::chrono::duration_cast<std::chrono::microseconds>(time - m_lastUpdate);
+
+    if (elapsed.count() < UpdateInterval)
+      return;
+
+    FILETIME created, exited, kernel, user;
+
+    if (GetProcessTimes(GetCurrentProcess(), &created, &exited, &kernel, &user)) {
+      auto toUs = [] (const FILETIME& ft) {
+        return ((uint64_t(ft.dwHighDateTime) << 32) | ft.dwLowDateTime) / 10;
+      };
+
+      uint64_t cpu = toUs(kernel) + toUs(user);
+
+      if (m_lastCpu)
+        m_load = ambreFormat(100.0f * float(cpu - m_lastCpu) / float(elapsed.count()), 0) + " %";
+
+      m_lastCpu = cpu;
+    }
+
+    m_lastUpdate = time;
+  }
+
+
+  HudPos HudCpuItem::render(
+          HudRenderer&      renderer,
+          HudPos            position) {
+    position.y += 16.0f;
+    renderer.drawText(16.0f, { position.x, position.y }, { 1.0f, 0.72f, 0.25f, 1.0f }, "Processeur");
+    renderer.drawText(16.0f, { position.x + 150.0f, position.y }, { 1.0f, 1.0f, 1.0f, 1.0f }, m_load);
+    position.y += 8.0f;
+    return position;
+  }
+
