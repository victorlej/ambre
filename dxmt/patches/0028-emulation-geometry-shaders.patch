+/* Ambre : émulation des geometry shaders DirectX 12 (prise générique ambre_dxil_convert2 du module
+   de conversion). Les sommets deviennent un « object shader », le geometry shader un « mesh
+   shader » ; la lecture des sommets est une fonction à part, liée au pipeline. */
+#define WMT_IR_GEOMETRY_EMULATION 1u
+
+/* Même disposition que IRVersionedInputLayoutDescriptor (version 1) du convertisseur d'Apple. */
+struct WMTIRInputElement {
+  uint32_t semantic_index;
+  uint32_t format; /* DXGI_FORMAT */
+  uint32_t input_slot;
+  uint32_t aligned_byte_offset;
+  uint32_t instance_data_step_rate;
+  uint32_t input_slot_class; /* 0 sommets, 1 instances */
+};
+
+struct WMTIRInputLayout {
+  uint32_t version; /* 1 */
+  uint32_t padding;
+  uint64_t semantic_names[31]; /* const char * */
+  struct WMTIRInputElement elements[31];
+  uint32_t num_elements;
+  uint32_t padding2;
+};
+
+struct WMTIRCompileInfo2 {
+  struct WMTIRCompileInfo base;
+  uint32_t flags;          /* WMT_IR_GEOMETRY_EMULATION */
+  uint32_t input_topology; /* D3D12_PRIMITIVE_TOPOLOGY_TYPE (= IRInputTopology) */
+  struct WMTConstMemoryPointer input_layout; /* struct WMTIRInputLayout (sommets émulés), ou NULL */
+};
+
+struct WMTIRReflection2 {
+  struct WMTIRReflection base;
+  uint32_t vertex_output_size;      /* sommets : taille d'un sommet en sortie */
+  uint32_t gs_max_input_primitives; /* geometry shader : primitives par groupe « mesh » */
+  uint32_t gs_max_payload_size;
+  uint32_t gs_input_primitive;
+  uint32_t gs_instance_count;
+  uint32_t gs_passthrough;
+  uint32_t reserved[10];
+};
+
+/* Rend la bibliothèque convertie et, pour des sommets émulés, celle de la lecture des sommets. */
+WINEMETAL_API obj_handle_t IRConverter_newLibrary2(
+    obj_handle_t device, const struct WMTIRCompileInfo2 *info, struct WMTIRReflection2 *reflection,
+    obj_handle_t *stage_in_library, char *error, uint64_t error_size
+);
+
+struct WMTGeometryEmulationPipelineInfo {
+  struct WMTMeshRenderPipelineInfo mesh; /* pièces jointes, mélange, formats ; fonctions ignorées */
+  obj_handle_t stage_in_library;
+  obj_handle_t vertex_library;
+  obj_handle_t geometry_library;
+  obj_handle_t fragment_function; /* ou 0 */
+  char vertex_function[128];
+  char geometry_function[128];
+  uint32_t vertex_output_size;
+  uint32_t padding;
+};
+
+WINEMETAL_API obj_handle_t MTLDevice_newGeometryEmulationPipeline(
+    obj_handle_t device, const struct WMTGeometryEmulationPipelineInfo *info, obj_handle_t *err_out
+);
