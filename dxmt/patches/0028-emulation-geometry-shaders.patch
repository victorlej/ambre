+  }
+  struct WMTIRReflection2 local_reflection;
+  void *bytes = NULL, *stage_in = NULL;
+  size_t size = 0, stage_in_size = 0;
+  if (ambre_dxil_convert2(info, reflection ? reflection : &local_reflection, &bytes, &size, &stage_in, &stage_in_size,
+                          error, error_size))
+    return STATUS_SUCCESS;
+  id<MTLLibrary> library = ambre_new_library((id<MTLDevice>)params->device, bytes, size, error, error_size);
+  ambre_dxil_free(bytes);
+  id<MTLLibrary> stage_in_library = nil;
+  if (stage_in) {
+    stage_in_library = library ? ambre_new_library((id<MTLDevice>)params->device, stage_in, stage_in_size, error, error_size)
+                               : nil;
+    ambre_dxil_free(stage_in);
+    if (!stage_in_library) {
+      [library release];
+      return STATUS_SUCCESS;
+    }
+  }
+  params->ret_library = (obj_handle_t)library;
+  params->ret_stage_in_library = (obj_handle_t)stage_in_library;
+  return STATUS_SUCCESS;
+}
+
+/* Ambre : pipeline mesh qui émule un geometry shader (même construction que
+   IRRuntimeNewGeometryEmulationPipeline du runtime d'Apple) : sommets en object shader
+   (« <nom>.dxil_irconverter_object_shader », tessellation coupée), lecture des sommets liée,
+   geometry shader en mesh shader (taille d'un sommet en constante), shader de pixels. */
+static NTSTATUS
+_MTLDevice_newGeometryEmulationPipeline(void *obj) {
+  struct unixcall_mtldevice_newgeometrypso *params = obj;
+  const struct WMTGeometryEmulationPipelineInfo *info = params->info.ptr;
+  params->ret_pso = 0;
+  params->ret_error = 0;
+  id<MTLLibrary> stage_in_library = (id<MTLLibrary>)info->stage_in_library;
+  id<MTLLibrary> vertex_library = (id<MTLLibrary>)info->vertex_library;
+  id<MTLLibrary> geometry_library = (id<MTLLibrary>)info->geometry_library;
+  MTLFunctionConstantValues *constants = [[MTLFunctionConstantValues alloc] init];
+  BOOL tessellation = NO;
+  [constants setConstantValue:&tessellation type:MTLDataTypeBool withName:@"tessellationEnabled"];
+  NSError *err = NULL;
+  id<MTLFunction> stage_in = [stage_in_library newFunctionWithName:stage_in_library.functionNames.firstObject];
+  NSString *object_name = [NSString stringWithFormat:@"%s.dxil_irconverter_object_shader", info->vertex_function];
+  id<MTLFunction> object = [vertex_library newFunctionWithName:object_name constantValues:constants error:&err];
+  id<MTLFunction> mesh = nil;
+  if (object) {
+    int vertex_size = (int)info->vertex_output_size;
+    [constants setConstantValue:&vertex_size type:MTLDataTypeInt withName:@"vertex_shader_output_size_fc"];
+    mesh = [geometry_library newFunctionWithName:[NSString stringWithUTF8String:info->geometry_function]
+                                  constantValues:constants
+                                           error:&err];
+  }
+  if (stage_in && object && mesh) {
+    MTLMeshRenderPipelineDescriptor *descriptor = [[MTLMeshRenderPipelineDescriptor alloc] init];
+    fill_mesh_render_pipeline_descriptor(descriptor, &info->mesh);
+    descriptor.objectFunction = object;
+    descriptor.meshFunction = mesh;
+    descriptor.fragmentFunction = (id<MTLFunction>)info->fragment_function;
+    MTLLinkedFunctions *linked = [[MTLLinkedFunctions alloc] init];
+    linked.functions = @[ stage_in ];
+    descriptor.objectLinkedFunctions = linked;
+    params->ret_pso = (obj_handle_t)[(id<MTLDevice>)params->device newRenderPipelineStateWithMeshDescriptor:descriptor
+                                                                                                    options:MTLPipelineOptionNone
+                                                                                                 reflection:nil
+                                                                                                      error:&err];
+    [linked release];
+    [descriptor release];
+  }
+  if (!params->ret_pso && err)
+    params->ret_error = (obj_handle_t)err;
+  [stage_in release];
+  [object release];
+  [mesh release];
+  [constants release];
+  return STATUS_SUCCESS;
+}
