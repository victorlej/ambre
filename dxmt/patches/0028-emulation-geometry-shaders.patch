+
+WINEMETAL_API obj_handle_t
+IRConverter_newLibrary2(
+    obj_handle_t device, const struct WMTIRCompileInfo2 *info, struct WMTIRReflection2 *reflection,
+    obj_handle_t *stage_in_library, char *error, uint64_t error_size
+) {
+  struct unixcall_irconverter_newlibrary2 params;
+  params.device = device;
+  WMT_MEMPTR_SET(params.info, info);
+  WMT_MEMPTR_SET(params.reflection, reflection);
+  WMT_MEMPTR_SET(params.error, error);
+  params.error_size = error_size;
+  params.ret_library = 0;
+  params.ret_stage_in_library = 0;
+  if (error && error_size)
+    error[0] = 0;
+  if (stage_in_library)
+    *stage_in_library = 0;
+  if (UNIX_CALL(147, &params))
+    return 0;
+  if (stage_in_library)
+    *stage_in_library = params.ret_stage_in_library;
+  return params.ret_library;
+}
+
+WINEMETAL_API obj_handle_t
+MTLDevice_newGeometryEmulationPipeline(
+    obj_handle_t device, const struct WMTGeometryEmulationPipelineInfo *info, obj_handle_t *err_out
+) {
+  struct unixcall_mtldevice_newgeometrypso params;
+  params.device = device;
+  WMT_MEMPTR_SET(params.info, info);
+  params.ret_pso = 0;
+  params.ret_error = 0;
+  if (UNIX_CALL(148, &params))
+    return 0;
+  if (err_out)
+    *err_out = params.ret_error;
+  return params.ret_pso;
+}
