 class MTLD3D12QueryHeap : public ID3D12QueryHeap {
 public:
+  /* Ambre : requêtes d'occlusion. Chaque BeginQuery reçoit un emplacement neuf (8 octets) dans
+     le tampon de visibilité de Metal ; le tas note l'emplacement de chaque requête pour
+     ResolveQueryData (0 = jamais commencée : lue comme « visible »). */
+  D3D12_QUERY_HEAP_TYPE Type = D3D12_QUERY_HEAP_TYPE_OCCLUSION;
+  std::vector<uint32_t> VisibilitySlots;
 };
 
+/* Ambre : tampon de visibilité commun (anneau d'emplacements de 8 octets, l'emplacement 0 vaut 1). */
+obj_handle_t AmbreVisibilityBuffer(class MTLD3D12Device *pDevice);
+uint32_t AmbreAllocVisibilitySlot(class MTLD3D12Device *pDevice);
