diff --git a/src/d3d12/d3d12_query_heap.cpp b/src/d3d12/d3d12_query_heap.cpp
index 904c58f..6eeec41 100644
--- a/src/d3d12/d3d12_query_heap.cpp
+++ b/src/d3d12/d3d12_query_heap.cpp
@@ -18,15 +18,64 @@
 
 #include "com/com_pointer.hpp"
 #include "d3d12_pageable.hpp"
+#include "thread.hpp"
+#include <atomic>
+#include <cstring>
 
 namespace dxmt {
 
+namespace {
+constexpr uint32_t kAmbreVisibilitySlots = 1u << 20; // 8 Mo : des centaines d'images d'avance
+dxmt::mutex ambre_visibility_lock;
+Rc<Buffer> ambre_visibility;
+uint64_t *ambre_visibility_mapped = nullptr;
+obj_handle_t ambre_visibility_handle = 0;
+std::atomic<uint32_t> ambre_visibility_next = 0;
+
+void
+AmbreEnsureVisibility(MTLD3D12Device *pDevice) {
+  std::unique_lock<dxmt::mutex> guard(ambre_visibility_lock);
+  if (ambre_visibility_handle)
+    return;
+  ambre_visibility = new Buffer(uint64_t(kAmbreVisibilitySlots) * 8, pDevice->GetMTLDevice());
+  Flags<BufferAllocationFlag> flags;
+  ambre_visibility->rename(ambre_visibility->allocate(flags));
+  ambre_visibility_mapped = (uint64_t *)ambre_visibility->current()->mappedMemory(0);
+  if (ambre_visibility_mapped) {
+    memset(ambre_visibility_mapped, 0, uint64_t(kAmbreVisibilitySlots) * 8);
+    ambre_visibility_mapped[0] = 1; // requête jamais commencée : « visible »
+  }
+  pDevice->RegisterResidencyAndVA(ambre_visibility->current());
+  ambre_visibility_handle = ambre_visibility->current()->buffer().handle;
+}
+} // namespace
+
+obj_handle_t
+AmbreVisibilityBuffer(MTLD3D12Device *pDevice) {
+  AmbreEnsureVisibility(pDevice);
+  return ambre_visibility_handle;
+}
+
+uint32_t
+AmbreAllocVisibilitySlot(MTLD3D12Device *pDevice) {
+  AmbreEnsureVisibility(pDevice);
+  uint32_t slot = 1 + ambre_visibility_next.fetch_add(1) % (kAmbreVisibilitySlots - 1);
+  // Remis à zéro au moment de l'enregistrement : l'emplacement a servi il y a un tour complet de
+  // l'anneau, la carte graphique en a fini depuis longtemps.
+  if (ambre_visibility_mapped)
+    ambre_visibility_mapped[slot] = 0;
+  return slot;
+}
+
 class MTLD3D12QueryHeapImpl : public MTLD3D12Pageable<MTLD3D12QueryHeap> {
 public:
   MTLD3D12QueryHeapImpl(MTLD3D12Device *pDevice) : MTLD3D12Pageable<MTLD3D12QueryHeap>(pDevice) {}
 
   HRESULT
   Initialize(const D3D12_QUERY_HEAP_DESC *pDesc) {
+    Type = pDesc->Type;
+    if (Type == D3D12_QUERY_HEAP_TYPE_OCCLUSION)
+      VisibilitySlots.assign(pDesc->Count, 0);
     return S_OK;
   }
 
