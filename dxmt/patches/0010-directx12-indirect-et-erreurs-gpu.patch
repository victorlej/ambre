+__attribute__((constructor)) static void
+ambre_metal_validation(void) {
+  const char *home = getenv("HOME");
+  char flag[PATH_MAX];
+  if (!home)
+    return;
+  snprintf(flag, sizeof(flag), "%s/Library/Application Support/Allia/Logs/metal-validation", home);
+  if (access(flag, F_OK) != 0)
