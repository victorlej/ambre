+uint64_t
+Buffer::offsetViewResourceID(BufferViewKey key, uint32_t first_element, uint32_t *remaining_elements) {
+  view_(key); // vues du format prêtes
+  std::unique_lock<dxmt::mutex> lock(mutex_);
+  auto allocation = current_.ptr();
+  if (!allocation || key.index >= viewDescriptors_.size())
+    return 0;
+  auto format = viewDescriptors_[key.index].format;
+  uint64_t texel_size = MTLGetTexelSize(format);
+  if (!texel_size)
+    return 0;
+  // Début de vue sur un multiple de 256 éléments (donc de 256 octets, exigence de Metal) ; le
+  // reste (< 256 éléments) passe par le décalage du convertisseur.
+  uint64_t offset = (uint64_t)(first_element & ~255u) * texel_size;
+  *remaining_elements = first_element & 255u;
+  uint64_t cache_key = ((uint64_t)key.index << 32) | (first_element >> 8);
+  auto found = allocation->ambre_offset_views_.find(cache_key);
+  if (found != allocation->ambre_offset_views_.end())
+    return found->second->gpu_resource_id;
+  uint64_t total_length = allocation->suballocation_size_ * allocation->suballocation_count_;
+  if (offset >= total_length)
+    return 0;
+  WMTTextureInfo info;
+  info.type = WMTTextureTypeTextureBuffer;
+  info.width = (total_length - offset) / texel_size;
+  info.height = 1;
+  info.depth = 1;
+  info.array_length = 1;
+  info.mipmap_level_count = 1;
+  info.sample_count = 1;
+  info.pixel_format = format;
+  info.options = allocation->info_.options;
+  auto usage = WMTTextureUsageShaderRead;
+  if (!allocation->flags().test(BufferAllocationFlag::GpuReadonly) &&
+      (allocation->flags().test(BufferAllocationFlag::GpuManaged) ||
+       allocation->flags().test(BufferAllocationFlag::GpuPrivate))) {
+    usage |= WMTTextureUsageShaderWrite;
+    if (format == WMTPixelFormatR32Uint || format == WMTPixelFormatR32Sint)
+      usage |= WMTTextureUsageShaderAtomic; // compteurs de UAV
+  }
+  info.usage = usage;
+  auto view = allocation->obj_.newTexture(info, offset, total_length - offset);
+  if (!view)
+    return 0;
+  auto id = info.gpu_resource_id;
+  allocation->ambre_offset_views_.emplace(cache_key, std::make_unique<BufferView>(std::move(view), id, 0));
+  return id;
+}
