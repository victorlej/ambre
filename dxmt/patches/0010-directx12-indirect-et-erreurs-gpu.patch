+// Tas visibles par les shaders : adresse de début → (fin, adresse de la copie), par type.
+struct IRHeapRange {
+  uint64_t end;
+  uint64_t ir_base;
+};
+static dxmt::mutex ir_heaps_lock;
+static std::map<uint64_t, IRHeapRange> ir_heaps[2];
+
+static void
+RegisterIRHeap(bool sampler, uint64_t base, uint64_t count, uint64_t ir_base) {
+  std::unique_lock<dxmt::mutex> lock(ir_heaps_lock);
+  ir_heaps[sampler][base] = {base + count * 32, ir_base};
+}
+
+static void
+UnregisterIRHeap(bool sampler, uint64_t base) {
+  std::unique_lock<dxmt::mutex> lock(ir_heaps_lock);
+  ir_heaps[sampler].erase(base);
+}
+
+uint64_t
+TranslateDescriptorTableAddress(uint64_t Address, bool Sampler) {
+  std::unique_lock<dxmt::mutex> lock(ir_heaps_lock);
+  auto &heaps = ir_heaps[Sampler];
+  auto it = heaps.upper_bound(Address);
+  if (it == heaps.begin())
+    return 0;
+  --it;
+  if (Address >= it->second.end)
+    return 0;
+  return it->second.ir_base + (Address - it->first) / 32 * 24;
+}
