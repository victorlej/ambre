+  void
+  ExecuteIndirectConverted(
+      MTLD3D12CommandSignature *sig, UINT MaxCommandCount, uint64_t ArgBufferAddress, uint64_t CountBufferAddress
+  ) {
+    static std::atomic<uint32_t> warned = 0;
+    if (!sig->SimpleArgument || (CountBufferAddress && MaxCommandCount > 1)) {
+      if (warned++ < 10)
+        WARN(
+            "ambre-dx12: ExecuteIndirect non pris en charge (arguments ", sig->SimpleArgument ? "simples" : "multiples",
+            ", compte ", CountBufferAddress ? "GPU" : "aucun", ", ", MaxCommandCount, " commandes) : saute"
+        );
+      return;
+    }
+    uint64_t offset = 0;
+    auto allocation = device_->LookupBufferByVA(ArgBufferAddress, &offset);
+    if (!allocation)
+      return;
+    auto buffer = allocation->buffer().handle;
+    auto count = std::min(MaxCommandCount, 4096u);
+    if (sig->CommandType == D3D12_INDIRECT_ARGUMENT_TYPE_DISPATCH) {
+      if (!PreDispatch())
+        return;
+      for (unsigned i = 0; i < count; i++) {
+        auto &cmd = allocator_->EncodeComputeCommand<wmtcmd_compute_dispatch_indirect>();
+        cmd.type = WMTComputeCommandDispatchIndirect;
+        cmd.indirect_args_buffer = buffer;
+        cmd.indirect_args_offset = offset + i * sig->ByteStride;
+      }
+      return;
+    }
+    WMTPrimitiveType primitive_type;
+    uint32_t cp_count;
+    if (!to_metal_primitive_type(topology_, primitive_type, cp_count))
+      return;
+    if (PreDraw() == DrawCallStatus::Invalid)
+      return;
+    bool indexed = sig->CommandType == D3D12_INDIRECT_ARGUMENT_TYPE_DRAW_INDEXED;
+    for (unsigned i = 0; i < count; i++) {
+      auto args_offset = offset + i * sig->ByteStride;
+      EncodeConvertedRenderBuffer(WMTRenderCommandSetVertexBuffer, buffer, args_offset, 4);
+      auto [Ptr, InfoOffset] = allocator_->AllocateGPUHeap(32, 16);
+      memset(Ptr, 0, 32);
+      uint16_t index_type_ir = indexed ? (index_type == WMTIndexTypeUInt32 ? 2 : 1) : 0;
+      memcpy(Ptr, &index_type_ir, sizeof(index_type_ir));
+      reinterpret_cast<uint8_t *>(Ptr)[2] = (uint8_t)primitive_type;
+      EncodeConvertedRenderBuffer(WMTRenderCommandSetVertexBuffer, allocator_->gpu_heap_buffer_.handle, InfoOffset, 5);
+      if (indexed) {
+        auto &cmd = allocator_->EncodeRenderCommand<wmtcmd_render_draw_indexed_indirect>();
+        cmd.type = WMTRenderCommandDrawIndexedIndirect;
+        cmd.primitive_type = primitive_type;
+        cmd.index_type = index_type;
+        cmd.index_buffer = index_buffer.handle;
+        cmd.index_buffer_offset = index_offset;
+        cmd.indirect_args_buffer = buffer;
+        cmd.indirect_args_offset = args_offset;
+      } else {
+        auto &cmd = allocator_->EncodeRenderCommand<wmtcmd_render_draw_indirect>();
+        cmd.type = WMTRenderCommandDrawIndirect;
+        cmd.primitive_type = primitive_type;
+        cmd.indirect_args_buffer = buffer;
+        cmd.indirect_args_offset = args_offset;
+      }
+    }
+  }
