   struct unixcall_generic_obj_noret *params = obj;
+  /* Ambre : erreurs de la carte graphique écrites dans le journal (sinon invisibles). */
+  static atomic_int ambre_gpu_errors = 0;
+  [(id<MTLCommandBuffer>)params->handle addCompletedHandler:^(id<MTLCommandBuffer> buffer) {
+    if (buffer.status != MTLCommandBufferStatusError)
+      return;
+    int count = atomic_fetch_add(&ambre_gpu_errors, 1) + 1;
+    if (count <= 20 || count % 1000 == 0)
+      fprintf(stderr, "ambre-gpu: erreur de la carte graphique n°%d : %s\n", count,
+              buffer.error ? [[buffer.error localizedDescription] UTF8String] : "?");
+  }];
   [(id<MTLCommandBuffer>)params->handle commit];
   return STATUS_SUCCESS;
 }
