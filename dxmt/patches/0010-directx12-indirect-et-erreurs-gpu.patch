+  setenv("MTL_DEBUG_LAYER", "1", 1);
+  setenv("MTL_DEBUG_LAYER_ERROR_MODE", "nslog", 1);
+  setenv("MTL_DEBUG_LAYER_WARNING_MODE", "nslog", 1);
