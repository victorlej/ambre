+    // horodatages GPU ; Unreal lit fréquence et calibrage au démarrage et s'arrête sinon.
+    if (!pFrequency)
+      return E_INVALIDARG;
+    LARGE_INTEGER frequency;
+    QueryPerformanceFrequency(&frequency);
