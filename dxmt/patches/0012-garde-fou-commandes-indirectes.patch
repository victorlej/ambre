+// Ambre : garde-fou des commandes indirectes. Les arguments écrits par la carte graphique sont
+// recopiés avant usage ; ceux qui sont absurdes (plus de 16 millions d'indices, de 1 million
+// d'instances, de 4 millions de groupes de calcul…) sont mis à zéro : un argument faux ne peut
+// plus occuper la carte graphique pendant des secondes (sous Windows, le pilote coupe ces
+// commandes ; sur Mac le jeu se figeait).
+static const char kAmbreClampSource[] = R"(
+#include <metal_stdlib>
+using namespace metal;
+struct AmbreClampArgs {
+  device const uint *src;
+  device uint *dst;
+  uint count;
+  uint stride;
+  uint kind;
+  uint pad;
+};
+vertex void ambre_clamp_draw(uint vid [[vertex_id]], constant AmbreClampArgs &a [[buffer(30)]]) {
+  if (vid >= a.count)
+    return;
+  device const uint *s = a.src + vid * a.stride;
+  device uint *d = a.dst + vid * 5;
+  uint n = a.kind == 1 ? 5 : 4;
+  for (uint i = 0; i < 5; i++)
+    d[i] = i < n ? s[i] : 0;
+  ulong total = ulong(d[0]) * ulong(max(d[1], 1u));
+  if (d[0] > (1u << 24) || d[1] > (1u << 20) || total > (1ul << 28)) {
+    d[0] = 0;
+    d[1] = 0;
+  }
+}
+kernel void ambre_clamp_dispatch(uint tid [[thread_position_in_grid]], constant AmbreClampArgs &a [[buffer(30)]]) {
+  if (tid >= a.count)
+    return;
+  device const uint *s = a.src + tid * a.stride;
+  device uint *d = a.dst + tid * 3;
+  uint x = s[0], y = s[1], z = s[2];
+  if (x > 65535 || y > 65535 || z > 65535 || ulong(x) * ulong(y) * ulong(z) > (1ul << 22)) {
+    x = 0;
+    y = 0;
+    z = 0;
+  }
+  d[0] = x;
+  d[1] = y;
+  d[2] = z;
+}
+)";
+
+struct AmbreClampPipelines {
+  WMT::Reference<WMT::RenderPipelineState> draw;
+  WMT::Reference<WMT::ComputePipelineState> dispatch;
+  bool tried = false;
+};
+
+static AmbreClampPipelines &
+AmbreClamp(WMT::Device device) {
+  static dxmt::mutex lock;
+  static std::map<obj_handle_t, AmbreClampPipelines> all;
+  std::unique_lock<dxmt::mutex> guard(lock);
+  auto &pipelines = all[device.handle];
+  if (pipelines.tried)
+    return pipelines;
+  pipelines.tried = true;
+  WMT::Reference<WMT::Error> err;
+  auto library = device.newLibraryWithSource(std::string_view(kAmbreClampSource, sizeof(kAmbreClampSource) - 1), err);
+  if (!library) {
+    ERR("ambre-dx12: garde-fou des commandes indirectes non compile : ", err.description().getUTF8String());
+    return pipelines;
+  }
+  WMTRenderPipelineInfo info;
+  WMT::InitializeRenderPipelineInfo(info);
+  info.rasterization_enabled = false;
+  auto draw_function = library.newFunction("ambre_clamp_draw");
+  info.vertex_function = draw_function.handle;
+  pipelines.draw = device.newRenderPipelineState(info, err);
+  auto dispatch_function = library.newFunction("ambre_clamp_dispatch");
+  pipelines.dispatch = device.newComputePipelineState(dispatch_function, err);
+  if (!pipelines.draw || !pipelines.dispatch)
+    ERR("ambre-dx12: garde-fou des commandes indirectes incomplet");
+  return pipelines;
+}
