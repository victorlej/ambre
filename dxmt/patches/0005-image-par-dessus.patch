+/* Ambre : image du module d'extension (compteur d'Allia), en haut à gauche, par-dessus le jeu. */
+void
+Presenter::encodeOverlay(WMT::RenderCommandEncoder &encoder) {
+  auto overlay = ambre::plugin().overlay;
+  if (!overlay || !present_overlay_)
+    return;
+  ambre::AmbreOverlayInfo info{};
+  if (!overlay(&info, nullptr, 0) || !info.width || !info.height || info.width > 4096 || info.height > 4096 ||
+      info.stride < info.width * 4)
+    return;
+
+  if (!overlay_ready_ || info.generation != overlay_generation_) {
+    size_t size = size_t(info.stride) * info.height;
+    overlay_staging_.resize(size);
+    if (!overlay(&info, overlay_staging_.data(), uint32_t(size)) || size_t(info.stride) * info.height > size)
+      return;
+    if (info.width != overlay_width_ || info.height != overlay_height_ || overlay_textures_format_ != overlay_format_) {
+      WMTTextureInfo texture_info;
+      texture_info.type = WMTTextureType2D;
+      texture_info.pixel_format = overlay_format_;
+      texture_info.usage = WMTTextureUsageShaderRead;
+      texture_info.options = WMTResourceStorageModeShared;
+      texture_info.width = info.width;
+      texture_info.height = info.height;
+      texture_info.depth = 1;
+      texture_info.mipmap_level_count = 1;
+      texture_info.sample_count = 1;
+      texture_info.array_length = 1;
+      for (auto &texture : overlay_textures_)
+        texture = device_.newTexture(texture_info);
+      overlay_width_ = info.width;
+      overlay_height_ = info.height;
+      overlay_textures_format_ = overlay_format_;
+    }
+    overlay_index_ = (overlay_index_ + 1) % 3;
+    overlay_textures_[overlay_index_].replaceRegion(
+        {0, 0, 0}, {info.width, info.height, 1}, 0, 0, overlay_staging_.data(), info.stride, 0
+    );
+    overlay_generation_ = info.generation;
+    overlay_ready_ = true;
+  }
+
+  // Taille : l'image est dessinée pour `scale` pixels par point ; l'écran du jeu en a contents_scale.
+  double drawable_width = layer_props_.drawable_width, drawable_height = layer_props_.drawable_height;
+  double pixels_per_point = layer_props_.contents_scale > 0 ? layer_props_.contents_scale : 1;
+  double factor = pixels_per_point / (info.scale > 0 ? info.scale : 1);
+  double w = info.width * factor, h = info.height * factor;
+  double inset = info.inset * pixels_per_point;
+  // Jamais plus de la moitié de l'écran.
+  double fit = std::min({1.0, (drawable_width * 0.5) / w, (drawable_height * 0.8) / h});
+  w *= fit;
+  h *= fit;
+  if (w < 8 || h < 8 || inset + w > drawable_width || inset + h > drawable_height)
+    return;
+
+  encoder.setRenderPipelineState(present_overlay_);
+  encoder.setFragmentTexture(overlay_textures_[overlay_index_], 0);
+  encoder.setViewport({inset, inset, w, h, 0, 1});
+  encoder.drawPrimitives(WMTPrimitiveTypeTriangle, 0, 3);
+}
+
 constexpr uint32_t kPresentFCIndex_BackbufferSizeMatched = 0x100;
 constexpr uint32_t kPresentFCIndex_HDRPQ = 0x101;
 constexpr uint32_t kPresentFCIndex_WithHDRMetadata = 0x102;
@@ -236,6 +299,27 @@ Presenter::buildRenderPipelineState(bool is_pq, bool with_hdr_metadata, bool is_
     present_pipeline.fragment_function = fs_present_quad_scaled;
     present_scale_ = device_.newRenderPipelineState(present_pipeline, error);
   }
+  // Ambre : image par-dessus le jeu, mélangée (alpha prémultiplié). Écran sRGB ou HDR : l'image
+  // (couleurs sRGB) est lue en linéaire pour garder ses couleurs.
+  {
+    auto fs_present_overlay = library.newFunction("fs_present_overlay");
+    WMTRenderPipelineInfo overlay_pipeline;
+    WMT::InitializeRenderPipelineInfo(overlay_pipeline);
+    overlay_pipeline.colors[0].pixel_format = layer_props_.pixel_format;
+    overlay_pipeline.colors[0].blending_enabled = true;
+    overlay_pipeline.colors[0].src_rgb_blend_factor = WMTBlendFactorOne;
+    overlay_pipeline.colors[0].src_alpha_blend_factor = WMTBlendFactorOne;
+    overlay_pipeline.colors[0].dst_rgb_blend_factor = WMTBlendFactorOneMinusSourceAlpha;
+    overlay_pipeline.colors[0].dst_alpha_blend_factor = WMTBlendFactorOneMinusSourceAlpha;
+    overlay_pipeline.vertex_function = vs_present_quad;
+    overlay_pipeline.fragment_function = fs_present_overlay;
+    present_overlay_ = device_.newRenderPipelineState(overlay_pipeline, error);
+    auto format = layer_props_.pixel_format;
+    overlay_format_ = (format == WMTPixelFormatBGRA8Unorm_sRGB || format == WMTPixelFormatRGBA8Unorm_sRGB ||
+                       format == WMTPixelFormatRGBA16Float)
+                          ? WMTPixelFormatBGRA8Unorm_sRGB
+                          : WMTPixelFormatBGRA8Unorm;
+  }
 }
 
 } // namespace dxmt
