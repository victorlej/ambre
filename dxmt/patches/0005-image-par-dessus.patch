diff --git a/src/dxmt/dxmt_ambre.hpp b/src/dxmt/dxmt_ambre.hpp
new file mode 100644
index 0000000..55f22ba
--- /dev/null
+++ b/src/dxmt/dxmt_ambre.hpp
@@ -0,0 +1,61 @@
+#pragma once
+
+/* Ambre : module d'extension chargé par DXMT (voir AMBRE_PRESENT_PLUGIN_DIR).
+ *
+ * Si la variable AMBRE_PRESENT_PLUGIN_DIR désigne un dossier, DXMT y charge
+ * ambre_present64.dll (ou ambre_present32.dll). Fonctions facultatives du module :
+ *
+ *   void ambre_present(void);
+ *     appelée à chaque image présentée ;
+ *
+ *   int ambre_overlay(struct AmbreOverlayInfo *info, void *pixels, uint32_t size);
+ *     image à poser par-dessus le jeu : renvoie 0 s'il n'y en a pas. Remplit `info` ; si
+ *     `pixels` n'est pas nul et `size` suffit (stride * height), y copie l'image
+ *     (BGRA 8 bits, alpha prémultiplié, lignes de haut en bas).
+ *
+ * Sans la variable, ou sans le module, DXMT fonctionne comme d'habitude. */
+
+#include <cstdint>
+#include <mutex>
+#include <string>
+#include "windows.h"
+
+namespace dxmt::ambre {
+
+struct AmbreOverlayInfo {
+  uint32_t width;       // pixels
+  uint32_t height;      // pixels
+  uint32_t stride;      // octets par ligne
+  float scale;          // pixels de l'image par point d'écran (2 : image dessinée pour Retina)
+  float inset;          // marge depuis le coin haut gauche, en points
+  uint64_t generation;  // change à chaque nouvelle image
+};
+
+struct Plugin {
+  void (*present)(void) = nullptr;
+  int (*overlay)(AmbreOverlayInfo *info, void *pixels, uint32_t size) = nullptr;
+};
+
+inline const Plugin &plugin() {
+  static Plugin loaded;
+  static std::once_flag once;
+  std::call_once(once, [] {
+    char dir[MAX_PATH];
+    DWORD length = GetEnvironmentVariableA("AMBRE_PRESENT_PLUGIN_DIR", dir, sizeof(dir));
+    if (!length || length >= sizeof(dir) - 32)
+      return;
+    std::string path(dir, length);
+    if (path.back() != '\\' && path.back() != '/')
+      path += '\\';
+    path += sizeof(void *) == 8 ? "ambre_present64.dll" : "ambre_present32.dll";
+    HMODULE module = LoadLibraryA(path.c_str());
+    if (!module)
+      return;
+    loaded.present = reinterpret_cast<void (*)(void)>(reinterpret_cast<void *>(GetProcAddress(module, "ambre_present")));
+    loaded.overlay = reinterpret_cast<int (*)(AmbreOverlayInfo *, void *, uint32_t)>(
+        reinterpret_cast<void *>(GetProcAddress(module, "ambre_overlay")));
+  });
+  return loaded;
+}
+
+} // namespace dxmt::ambre
