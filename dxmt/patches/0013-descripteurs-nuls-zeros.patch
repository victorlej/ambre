 }
 
+uint64_t
+AmbreZeroBufferAddress(MTLD3D12Device *pDevice) {
+  static dxmt::mutex lock;
+  static Rc<Buffer> zero;
+  static uint64_t address = 0;
+  std::unique_lock<dxmt::mutex> guard(lock);
+  if (!address) {
+    zero = new Buffer(65536, pDevice->GetMTLDevice());
+    Flags<BufferAllocationFlag> flags;
+    zero->rename(zero->allocate(flags));
+    if (auto mapped = zero->current()->mappedMemory(0))
+      memset(mapped, 0, 65536);
+    pDevice->RegisterResidencyAndVA(zero->current());
+    address = zero->current()->gpuAddress();
+  }
+  return address;
+}
