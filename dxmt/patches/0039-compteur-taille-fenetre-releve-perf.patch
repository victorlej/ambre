+  void
+  AmbrePerfCommandBuffer(WMT::CommandBuffer cmdbuf) {
+    uint64_t start = cmdbuf.gpuStartTime(), end = cmdbuf.gpuEndTime();
+    if (!start || end <= start)
+      return;
+    if (!perf_window_start_)
+      perf_window_start_ = start;
+    if (end > perf_last_end_) {
+      perf_busy_ns_ += end - std::max(start, perf_last_end_);
+      perf_last_end_ = end;
+    }
+    perf_cmdbufs_++;
+    uint64_t window = perf_last_end_ - perf_window_start_;
+    if (window < 10'000'000'000ull)
+      return;
