+      pipelines = ", pipelines crees " + std::to_string(count - perf_pipelines_seen_) + " (" +
+                  std::to_string((ns - perf_pipeline_ns_seen_) / 1000000) + " ms, le plus long " +
+                  std::to_string(max / 1000000) + " ms)";
+      perf_pipelines_seen_ = count;
+      perf_pipeline_ns_seen_ = ns;
+    }
+    WARN(
+        "ambre-perf: file ", kind, " : puce graphique occupee ", int(100.0 * perf_busy_ns_ / window), " %, ",
+        int(perf_cmdbufs_ / seconds), " lots/s (", int(syncs / seconds), " envois/s), preparation ",
+        int(encode / 1e6 / seconds), " ms/s, file pleine ", int(full / 1e6 / seconds), " ms/s", pipelines
+    );
+    perf_window_start_ = perf_last_end_;
+    perf_busy_ns_ = 0;
+    perf_cmdbufs_ = 0;
+  }
