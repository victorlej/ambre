+                       : desc_.Type == D3D12_COMMAND_LIST_TYPE_COMPUTE ? "calcul"
+                       : desc_.Type == D3D12_COMMAND_LIST_TYPE_COPY ? "copie" : "autre";
+    uint64_t syncs = perf_syncs_.exchange(0), encode = perf_encode_ns_.exchange(0), full = perf_full_ns_.exchange(0);
