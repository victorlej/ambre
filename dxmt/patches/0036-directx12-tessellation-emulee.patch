+    mesh = [domain_library newFunctionWithName:[NSString stringWithUTF8String:info->passthrough_function]];
+  if (stage_in && object && hull && tessellator && domain && mesh) {
+    MTLMeshRenderPipelineDescriptor *descriptor = [[MTLMeshRenderPipelineDescriptor alloc] init];
+    fill_mesh_render_pipeline_descriptor(descriptor, &info->mesh);
+    descriptor.objectFunction = object;
+    descriptor.meshFunction = mesh;
+    descriptor.fragmentFunction = (id<MTLFunction>)info->fragment_function;
+    MTLLinkedFunctions *object_linked = [[MTLLinkedFunctions alloc] init];
+    object_linked.functions = @[ stage_in, hull ];
+    descriptor.objectLinkedFunctions = object_linked;
+    MTLLinkedFunctions *mesh_linked = [[MTLLinkedFunctions alloc] init];
+    mesh_linked.functions = @[ tessellator, domain ];
+    descriptor.meshLinkedFunctions = mesh_linked;
+    params->ret_pso = (obj_handle_t)[(id<MTLDevice>)params->device newRenderPipelineStateWithMeshDescriptor:descriptor
+                                                                                                    options:MTLPipelineOptionNone
+                                                                                                 reflection:nil
+                                                                                                      error:&err];
+    [object_linked release];
+    [mesh_linked release];
+    [descriptor release];
+  }
+  if (!params->ret_pso && err)
+    params->ret_error = (obj_handle_t)err;
+  [stage_in release];
+  [object release];
+  [hull release];
+  [tessellator release];
+  [domain release];
+  [mesh release];
+  [object_constants release];
+  [hull_constants release];
+  return STATUS_SUCCESS;
+}
