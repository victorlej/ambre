+/* Ambre (0036) : tables du tessellateur converti (fonction « irconverter_tessellator »), fournies
+   par le module de conversion (données d'Apple, Apache 2.0) et attendues à l'index 7
+   (kIRRuntimeTessellatorTablesBindPoint). Sans elles, les triangles qui touchent un bord du patch
+   disparaissaient. Un tampon par appareil, chargé au premier dessin tessellé. */
+static id<MTLBuffer>
+ambre_tessellator_tables(id<MTLDevice> device) {
+  static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+  static id<MTLDevice> owner = nil;
+  static id<MTLBuffer> buffer = nil;
+  static bool tried = false;
+  pthread_mutex_lock(&lock);
+  if (owner != device) {
+    [buffer release];
+    buffer = nil;
+    owner = device;
+    tried = false;
+  }
+  if (!buffer && !tried) {
+    tried = true;
+    pthread_once(&ambre_dxil_once, ambre_dxil_load);
+    uint64_t size = ambre_dxil_tessellator_tables ? ambre_dxil_tessellator_tables(NULL, 0) : 0;
+    if (size) {
+      buffer = [device newBufferWithLength:size options:MTLResourceStorageModeShared];
+      if (buffer)
+        ambre_dxil_tessellator_tables([buffer contents], size);
+    } else {
+      fprintf(stderr, "ambre-dx12: tables du tessellateur absentes du module (tessellation incomplete)\n");
+    }
+  }
+  id<MTLBuffer> result = buffer;
+  pthread_mutex_unlock(&lock);
+  return result;
+}
