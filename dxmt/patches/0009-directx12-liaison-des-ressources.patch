+// Métadonnées d'un tampon pour le convertisseur : taille (32 bits), décalage de la vue en
+// éléments (8 bits, à partir du bit 32), tampon typé (bit 63).
+inline uint64_t
+IRBufferMetadata(uint64_t byte_length, uint32_t view_offset_in_elements, bool typed) {
+  return (byte_length & 0xffffffff) | ((uint64_t)(view_offset_in_elements & 0xff) << 32) | ((uint64_t)typed << 63);
+}
