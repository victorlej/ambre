+  // Ambre : arguments racine au format du Metal Shader Converter. Même disposition que DXMT
+  // (un mot de 64 bits par table ou descripteur racine, constantes par paires) ; seules les
+  // adresses de tables changent : tas de DXMT (32 octets) → tas miroir (24 octets).
+  uint64_t
+  EncodeConvertedRootArgument(MTLD3D12RootSignature *pRootSig, uint64_t const pStaging[64]) {
+    auto qwords = std::max(pRootSig->UploadQwords, 1u);
+    auto [Ptr, Offset] = allocator_->AllocateGPUHeap(sizeof(uint64_t) * qwords, 64);
+    auto out = reinterpret_cast<uint64_t *>(Ptr);
+    memcpy(out, pStaging, pRootSig->UploadQwords * sizeof(uint64_t));
+    for (unsigned i = 0; i < pRootSig->ParameterSlots; i++) {
+      auto kind = pRootSig->SlotTableKinds[i];
+      if (!kind)
+        continue;
+      auto &value = out[pRootSig->SlotQwordOffsets[i]];
+      uint64_t base = 0, ir_base = 0;
+      if (kind == 1 && heap_resources_) {
+        base = heap_resources_->GPUBaseAddress;
+        ir_base = heap_resources_->IRBaseAddress;
+      } else if (kind == 2 && heap_samplers_) {
+        base = heap_samplers_->GPUBaseAddress;
+        ir_base = heap_samplers_->IRBaseAddress;
+      }
+      if (ir_base && value >= base)
+        value = ir_base + (value - base) / 32 * 24;
+    }
+    return Offset;
+  }
