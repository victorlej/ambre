+  template <typename SetBuffer>
+  void
+  BindConvertedArguments(MTLD3D12RootSignature *pRootSig, uint64_t const pStaging[64], SetBuffer set_buffer) {
+    if (pRootSig)
+      set_buffer(allocator_->gpu_heap_buffer_.handle, EncodeConvertedRootArgument(pRootSig, pStaging), 2);
+    if (heap_resources_ && heap_resources_->IRBuffer.handle)
+      set_buffer(heap_resources_->IRBuffer.handle, 0, 0);
+    if (heap_samplers_ && heap_samplers_->IRBuffer.handle)
+      set_buffer(heap_samplers_->IRBuffer.handle, 0, 1);
+  }
