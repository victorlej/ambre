+/* Ambre : ray tracing DirectX 12 (prise générique ambre_dxil_rt_convert du module de conversion).
+   Un export d'une bibliothèque DXIL de ray tracing devient une fonction Metal « visible » ; avec
+   WMT_IR_RT_DISPATCH, la fonction de lancement des rayons (« RaygenIndirection ») est synthétisée.
+   Dans la table des fonctions visibles, l'indice 0 est réservé (« pas de shader »). */
+#define WMT_IR_RT_DISPATCH 1u
+
+struct WMTIRRTCompileInfo {
+  struct WMTIRCompileInfo base; /* dxil = bibliothèque ; root_signature = signature racine globale */
+  struct WMTConstMemoryPointer local_root_signature; /* D3D12_VERSIONED_ROOT_SIGNATURE_DESC, ou NULL */
+  char export_name[128];
+  uint32_t flags;
+  uint32_t max_attribute_size;
+  uint32_t max_recursion_depth;
+  uint32_t hit_group_type; /* 0 : triangles, 1 : primitives procédurales */
+};
+
+struct WMTIRRTReflection {
+  uint32_t stage; /* IRShaderStage : 9 plus proche touche, 10 intersection, 11 any-hit, 12 manqué, 13 génération, 14 appelable */
+  uint32_t reserved;
+  char entry_point[128];
+};
+
+WINEMETAL_API obj_handle_t IRConverter_newRayTracingLibrary(
+    obj_handle_t device, const struct WMTIRRTCompileInfo *info, struct WMTIRRTReflection *reflection, char *error,
+    uint64_t error_size
+);
+
+struct WMTRayTracingPipelineInfo {
+  obj_handle_t dispatch_function;          /* « RaygenIndirection » */
+  struct WMTConstMemoryPointer functions;  /* obj_handle_t[function_count] : fonctions visibles (indices 1..n) */
+  uint32_t function_count;
+  uint32_t max_call_stack_depth;
+};
+
+/* Rend le pipeline de calcul ; la table des fonctions visibles (n + 1 entrées) et son identifiant
+   GPU sont rendus en sortie. */
+WINEMETAL_API obj_handle_t MTLDevice_newRayTracingPipeline(
+    obj_handle_t device, const struct WMTRayTracingPipelineInfo *info, obj_handle_t *table_out,
+    uint64_t *table_id_out, obj_handle_t *err_out
+);
+
 #endif
