+/* Ambre : ray tracing DirectX 12. */
+static NTSTATUS
+_IRConverter_newRayTracingLibrary(void *obj) {
+  struct unixcall_irconverter_newrtlibrary *params = obj;
+  const struct WMTIRRTCompileInfo *info = params->info.ptr;
+  struct WMTIRRTReflection *reflection = params->reflection.ptr;
+  char *error = params->error.ptr;
+  size_t error_size = params->error_size;
+  char fallback[256];
+  if (!error || !error_size) {
+    error = fallback;
+    error_size = sizeof(fallback);
+  }
+  params->ret_library = 0;
+  pthread_once(&ambre_dxil_once, ambre_dxil_load);
+  if (!ambre_dxil_rt_convert) {
+    snprintf(error, error_size, "module de conversion DXIL sans ray tracing");
+    return STATUS_SUCCESS;
+  }
+  struct WMTIRRTReflection local_reflection;
+  void *bytes = NULL;
+  size_t size = 0;
+  if (ambre_dxil_rt_convert(info, reflection ? reflection : &local_reflection, &bytes, &size, error, error_size))
+    return STATUS_SUCCESS;
+  params->ret_library = (obj_handle_t)ambre_new_library((id<MTLDevice>)params->device, bytes, size, error, error_size);
+  ambre_dxil_free(bytes);
+  return STATUS_SUCCESS;
+}
+
+/* Pipeline de lancement des rayons : « RaygenIndirection » avec toutes les fonctions visibles liées,
+   et une table de fonctions visibles (indice 0 réservé : « pas de shader »). */
+static NTSTATUS
+_MTLDevice_newRayTracingPipeline(void *obj) {
+  struct unixcall_mtldevice_newrtpso *params = obj;
+  const struct WMTRayTracingPipelineInfo *info = params->info.ptr;
+  const obj_handle_t *functions = info->functions.ptr;
+  params->ret_pso = 0;
+  params->ret_table = 0;
+  params->ret_table_id = 0;
+  params->ret_error = 0;
+  @autoreleasepool {
+    id<MTLDevice> device = (id<MTLDevice>)params->device;
+    NSMutableArray<id<MTLFunction>> *list = [NSMutableArray arrayWithCapacity:info->function_count];
+    for (uint32_t i = 0; i < info->function_count; i++)
+      [list addObject:(id<MTLFunction>)functions[i]];
+    MTLComputePipelineDescriptor *descriptor = [[MTLComputePipelineDescriptor alloc] init];
+    descriptor.computeFunction = (id<MTLFunction>)info->dispatch_function;
+    MTLLinkedFunctions *linked = [MTLLinkedFunctions linkedFunctions];
+    linked.functions = list;
+    descriptor.linkedFunctions = linked;
+    descriptor.maxCallStackDepth = info->max_call_stack_depth ? info->max_call_stack_depth : 8;
+    NSError *err = nil;
+    id<MTLComputePipelineState> pso = [device newComputePipelineStateWithDescriptor:descriptor
+                                                                           options:MTLPipelineOptionNone
+                                                                        reflection:nil
+                                                                             error:&err];
+    [descriptor release];
+    if (!pso) {
+      if (err)
+        params->ret_error = (obj_handle_t)[err retain];
+      return STATUS_SUCCESS;
+    }
+    MTLVisibleFunctionTableDescriptor *table_descriptor = [MTLVisibleFunctionTableDescriptor visibleFunctionTableDescriptor];
+    table_descriptor.functionCount = info->function_count + 1;
+    id<MTLVisibleFunctionTable> table = [pso newVisibleFunctionTableWithDescriptor:table_descriptor];
+    for (uint32_t i = 0; i < info->function_count; i++)
+      [table setFunction:[pso functionHandleWithFunction:list[i]] atIndex:i + 1];
+    MTLResourceID table_id = [table gpuResourceID];
+    params->ret_pso = (obj_handle_t)pso;
+    params->ret_table = (obj_handle_t)table;
+    params->ret_table_id = *(uint64_t *)&table_id;
+  }
+  return STATUS_SUCCESS;
+}
+
