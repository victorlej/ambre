+// Ambre : objet d'état de ray tracing (ID3D12StateObject). Les shaders de la bibliothèque DXIL sont
+// convertis en fonctions Metal « visibles » liées au noyau de lancement des rayons ; les
+// identifiants de shaders (32 octets, IRShaderIdentifier) sont des indices dans la table des
+// fonctions visibles (l'indice 0 veut dire « pas de shader »).
+class MTLD3D12RTStateObject : public MTLD3D12Pageable<ID3D12StateObject, ID3D12StateObjectProperties> {
+public:
+  MTLD3D12RTStateObject(MTLD3D12Device *pDevice)
+      : MTLD3D12Pageable<ID3D12StateObject, ID3D12StateObjectProperties>(pDevice) {}
+
+  HRESULT Initialize(const D3D12_STATE_OBJECT_DESC *pDesc);
+
+  HRESULT STDMETHODCALLTYPE QueryInterface(REFIID riid, void **ppvObject) override;
+
+  void *STDMETHODCALLTYPE GetShaderIdentifier(const WCHAR *pExportName) override;
+  UINT64 STDMETHODCALLTYPE GetShaderStackSize(const WCHAR *pExportName) override;
+  UINT64 STDMETHODCALLTYPE GetPipelineStackSize() override { return pipeline_stack_size_; }
+  void STDMETHODCALLTYPE SetPipelineStackSize(UINT64 Size) override { pipeline_stack_size_ = Size; }
+
+  // Pipeline de lancement (« RaygenIndirection » + fonctions visibles liées) et sa table.
+  WMT::Reference<WMT::ComputePipelineState> pso;
+  WMT::Reference<WMT::Resource> table;
+  uint64_t table_id = 0;
+  std::vector<WMT::Reference<WMT::Function>> functions;
+  Com<MTLD3D12RootSignature, false> global_root_signature;
+  uint32_t max_attribute_size = 8;
+  uint32_t max_payload_size = 16;
+  uint32_t max_recursion_depth = 1;
+  // Identifiant (32 octets) de chaque export (shaders et groupes de touche).
+  std::map<std::string, std::array<uint8_t, 32>> identifiers;
+
+private:
+  UINT64 pipeline_stack_size_ = 0;
+};
+
+HRESULT CreateRTStateObject(
+    MTLD3D12Device *pDevice, const D3D12_STATE_OBJECT_DESC *pDesc, REFIID riid, void **ppStateObject
+);
+
 } // namespace dxmt
diff --git a/src/d3d12/d3d12_state_object.cpp b/src/d3d12/d3d12_state_object.cpp
new file mode 100644
index 0000000..c043247
--- /dev/null
+++ b/src/d3d12/d3d12_state_object.cpp
@@ -0,0 +1,332 @@
+/*
+ * Ambre : DirectX Raytracing sur Metal (correctif 0033) — objets d'état de ray tracing.
+ *
+ * ID3D12Device5::CreateStateObject : les bibliothèques DXIL de ray tracing sont converties export
+ * par export par le module de conversion (prise ambre_dxil_rt_convert), liées au noyau de lancement
+ * des rayons synthétisé par le convertisseur d'Apple, et rangées dans une table de fonctions
+ * visibles. Ce fichier suit la licence de DXMT (LGPL 2.1).
+ */
+
+#include "d3d12_raytracing.hpp"
+#include "com/com_pointer.hpp"
+#include "log/log.hpp"
+#include "Metal.hpp"
+#include <algorithm>
+#include <atomic>
+#include <unordered_map>
+#include <unordered_set>
+
+namespace dxmt {
+
+namespace {
+
+// IRShaderStage (metal_irconverter.h).
+enum RTStage : uint32_t {
+  kStageClosestHit = 9,
+  kStageIntersection = 10,
+  kStageAnyHit = 11,
+  kStageMiss = 12,
+  kStageRayGeneration = 13,
+  kStageCallable = 14,
+};
+
+std::string
+Narrow(const WCHAR *text) {
+  std::string out;
+  if (!text)
+    return out;
+  for (; *text; text++)
+    out.push_back(*text < 0x80 ? (char)*text : '?');
+  return out;
+}
+
+struct HitGroup {
+  std::string name;
+  bool procedural = false;
+  std::string any_hit, closest_hit, intersection;
+};
+
+struct ExportInfo {
+  std::string name;      // nom exporté
+  std::string dxil_name; // nom dans la bibliothèque
+  size_t library = 0;
+};
+
+} // namespace
+
+HRESULT STDMETHODCALLTYPE
+MTLD3D12RTStateObject::QueryInterface(REFIID riid, void **ppvObject) {
+  if (!ppvObject)
+    return E_POINTER;
+  *ppvObject = nullptr;
+  if (riid == __uuidof(IUnknown) || riid == __uuidof(ID3D12Object) || riid == __uuidof(ID3D12DeviceChild) ||
+      riid == __uuidof(ID3D12Pageable) || riid == __uuidof(ID3D12StateObject)) {
+    *ppvObject = static_cast<ID3D12StateObject *>(ref(this));
+    return S_OK;
+  }
+  if (riid == __uuidof(ID3D12StateObjectProperties)) {
+    *ppvObject = static_cast<ID3D12StateObjectProperties *>(ref(this));
+    return S_OK;
+  }
+  if (logQueryInterfaceError(__uuidof(ID3D12StateObject), riid))
+    WARN("D3D12StateObject: Unknown interface query ", str::format(riid));
+  return E_NOINTERFACE;
+}
+
+void *STDMETHODCALLTYPE
+MTLD3D12RTStateObject::GetShaderIdentifier(const WCHAR *pExportName) {
+  auto found = identifiers.find(Narrow(pExportName));
+  return found == identifiers.end() ? nullptr : found->second.data();
+}
+
+UINT64 STDMETHODCALLTYPE
+MTLD3D12RTStateObject::GetShaderStackSize(const WCHAR *pExportName) {
+  // Metal gère lui-même la pile des appels de fonctions visibles (maxCallStackDepth).
+  return identifiers.count(Narrow(pExportName)) ? 0 : ~UINT64(0);
+}
+
+HRESULT
+MTLD3D12RTStateObject::Initialize(const D3D12_STATE_OBJECT_DESC *pDesc) {
+  if (!pDesc || !pDesc->pSubobjects)
+    return E_INVALIDARG;
+  if (pDesc->Type != D3D12_STATE_OBJECT_TYPE_RAYTRACING_PIPELINE) {
+    WARN("ambre-dx12: objet d'etat de type collection pas encore pris en charge");
+    return E_NOTIMPL;
+  }
+
+  // -- 1. Lecture des sous-objets.
+  std::vector<const D3D12_DXIL_LIBRARY_DESC *> libraries;
+  std::vector<HitGroup> hit_groups;
+  struct Association {
+    const D3D12_STATE_SUBOBJECT *subobject;
+    std::vector<std::string> exports;
+  };
+  std::vector<Association> associations;
+  for (UINT i = 0; i < pDesc->NumSubobjects; i++) {
+    const auto &sub = pDesc->pSubobjects[i];
+    if (!sub.pDesc)
+      continue;
+    switch (sub.Type) {
+    case D3D12_STATE_SUBOBJECT_TYPE_GLOBAL_ROOT_SIGNATURE: {
+      auto *rs = static_cast<const D3D12_GLOBAL_ROOT_SIGNATURE *>(sub.pDesc)->pGlobalRootSignature;
+      if (rs)
+        global_root_signature = static_cast<MTLD3D12RootSignature *>(rs);
+      break;
+    }
+    case D3D12_STATE_SUBOBJECT_TYPE_DXIL_LIBRARY:
+      libraries.push_back(static_cast<const D3D12_DXIL_LIBRARY_DESC *>(sub.pDesc));
+      break;
+    case D3D12_STATE_SUBOBJECT_TYPE_HIT_GROUP: {
+      auto *d = static_cast<const D3D12_HIT_GROUP_DESC *>(sub.pDesc);
+      HitGroup g;
+      g.name = Narrow(d->HitGroupExport);
+      g.procedural = d->Type == D3D12_HIT_GROUP_TYPE_PROCEDURAL_PRIMITIVE;
+      g.any_hit = Narrow(d->AnyHitShaderImport);
+      g.closest_hit = Narrow(d->ClosestHitShaderImport);
+      g.intersection = Narrow(d->IntersectionShaderImport);
+      hit_groups.push_back(std::move(g));
+      break;
+    }
+    case D3D12_STATE_SUBOBJECT_TYPE_RAYTRACING_SHADER_CONFIG: {
+      auto *d = static_cast<const D3D12_RAYTRACING_SHADER_CONFIG *>(sub.pDesc);
+      max_payload_size = d->MaxPayloadSizeInBytes;
+      max_attribute_size = d->MaxAttributeSizeInBytes;
+      break;
+    }
+    case D3D12_STATE_SUBOBJECT_TYPE_RAYTRACING_PIPELINE_CONFIG:
+      max_recursion_depth = static_cast<const D3D12_RAYTRACING_PIPELINE_CONFIG *>(sub.pDesc)->MaxTraceRecursionDepth;
+      break;
+    case D3D12_STATE_SUBOBJECT_TYPE_SUBOBJECT_TO_EXPORTS_ASSOCIATION: {
+      auto *d = static_cast<const D3D12_SUBOBJECT_TO_EXPORTS_ASSOCIATION *>(sub.pDesc);
+      Association a;
+      a.subobject = d->pSubobjectToAssociate;
+      for (UINT k = 0; k < d->NumExports; k++)
+        a.exports.push_back(Narrow(d->pExports[k]));
+      associations.push_back(std::move(a));
+      break;
+    }
+    case D3D12_STATE_SUBOBJECT_TYPE_EXISTING_COLLECTION:
+      WARN("ambre-dx12: collection existante pas encore prise en charge");
+      break;
+    default:
+      break;
+    }
+  }
+  if (libraries.empty()) {
+    WARN("ambre-dx12: objet d'etat de ray tracing sans bibliotheque DXIL");
+    return E_INVALIDARG;
+  }
+
+  // -- 2. Exports, signatures racine locales (par export ; association sans export = par défaut).
+  std::vector<ExportInfo> exports;
+  for (size_t l = 0; l < libraries.size(); l++) {
+    const auto *lib = libraries[l];
+    if (!lib->NumExports) {
+      WARN("ambre-dx12: bibliotheque DXIL sans liste d'exports pas encore prise en charge");
+      continue;
+    }
+    for (UINT k = 0; k < lib->NumExports; k++) {
+      ExportInfo e;
+      e.name = Narrow(lib->pExports[k].Name);
+      e.dxil_name = lib->pExports[k].ExportToRename ? Narrow(lib->pExports[k].ExportToRename) : e.name;
+      e.library = l;
+      exports.push_back(std::move(e));
+    }
+  }
+  std::unordered_map<std::string, MTLD3D12RootSignature *> local_signature;
+  MTLD3D12RootSignature *default_local_signature = nullptr;
+  std::unordered_map<std::string, const HitGroup *> hit_group_by_name;
+  for (auto &g : hit_groups)
+    hit_group_by_name[g.name] = &g;
+  for (auto &a : associations) {
+    if (!a.subobject || a.subobject->Type != D3D12_STATE_SUBOBJECT_TYPE_LOCAL_ROOT_SIGNATURE || !a.subobject->pDesc)
+      continue;
+    auto *rs = static_cast<const D3D12_LOCAL_ROOT_SIGNATURE *>(a.subobject->pDesc)->pLocalRootSignature;
+    if (!rs)
+      continue;
+    auto *signature = static_cast<MTLD3D12RootSignature *>(rs);
+    if (a.exports.empty()) {
+      default_local_signature = signature;
+      continue;
+    }
+    for (auto &name : a.exports) {
+      local_signature[name] = signature;
+      if (auto g = hit_group_by_name.find(name); g != hit_group_by_name.end()) {
+        for (auto *member : {&g->second->any_hit, &g->second->closest_hit, &g->second->intersection})
+          if (!member->empty() && !local_signature.count(*member))
+            local_signature[*member] = signature;
+      }
+    }
+  }
+  std::unordered_map<std::string, bool> procedural_member;
+  for (auto &g : hit_groups)
+    for (auto *member : {&g.any_hit, &g.closest_hit, &g.intersection})
+      if (!member->empty())
+        procedural_member[*member] = g.procedural;
+
+  // -- 3. Conversion export par export.
+  auto metal = device_->GetMTLDevice();
+  std::unordered_map<std::string, uint32_t> handle_by_export; // nom exporté -> indice dans la table (1..n)
+  std::unordered_map<std::string, uint32_t> stage_by_export;
+  for (auto &e : exports) {
+    const auto &library = libraries[e.library]->DXILLibrary;
+    WMTIRRTCompileInfo info;
+    memset(&info, 0, sizeof(info));
+    info.base.dxil.set(library.pShaderBytecode);
+    info.base.dxil_size = library.BytecodeLength;
+    info.base.root_signature.set(global_root_signature ? global_root_signature->GetVersionedDesc() : nullptr);
+    MTLD3D12RootSignature *local = default_local_signature;
+    if (auto found = local_signature.find(e.name); found != local_signature.end())
+      local = found->second;
+    info.local_root_signature.set(local ? local->GetVersionedDesc() : nullptr);
+    snprintf(info.export_name, sizeof(info.export_name), "%s", e.dxil_name.c_str());
+    info.max_attribute_size = max_attribute_size;
+    info.max_recursion_depth = max_recursion_depth;
+    auto procedural = procedural_member.find(e.name);
+    info.hit_group_type = procedural != procedural_member.end() && procedural->second ? 1 : 0;
+    WMTIRRTReflection reflection;
+    memset(&reflection, 0, sizeof(reflection));
+    char error[512];
+    auto handle = IRConverter_newRayTracingLibrary(metal.handle, &info, &reflection, error, sizeof(error));
+    if (!handle) {
+      ERR("ambre-dx12: shader de ray tracing ", e.dxil_name, " non converti : ", error);
+      return E_FAIL;
+    }
+    WMT::Reference<WMT::Library> lib(handle);
+    stage_by_export[e.name] = reflection.stage;
+    if (reflection.stage == kStageAnyHit || reflection.stage == kStageIntersection) {
+      // Pas encore pris en charge : le groupe de touche garde son plus proche touche, la géométrie
+      // est traitée comme opaque.
+      continue;
+    }
+    auto function = lib.newFunction(reflection.entry_point);
+    if (!function) {
+      ERR("ambre-dx12: fonction ", reflection.entry_point, " absente du shader ", e.dxil_name);
+      return E_FAIL;
+    }
+    functions.push_back(function);
+    handle_by_export[e.name] = (uint32_t)functions.size(); // indice 0 réservé
+  }
+
+  // -- 4. Noyau de lancement et pipeline.
+  WMT::Reference<WMT::Function> dispatch;
+  {
+    WMTIRRTCompileInfo info;
+    memset(&info, 0, sizeof(info));
+    info.base.root_signature.set(global_root_signature ? global_root_signature->GetVersionedDesc() : nullptr);
+    info.flags = WMT_IR_RT_DISPATCH;
+    info.max_attribute_size = max_attribute_size;
+    info.max_recursion_depth = max_recursion_depth;
+    WMTIRRTReflection reflection;
+    memset(&reflection, 0, sizeof(reflection));
+    char error[512];
+    auto handle = IRConverter_newRayTracingLibrary(metal.handle, &info, &reflection, error, sizeof(error));
+    if (!handle) {
+      ERR("ambre-dx12: noyau de lancement des rayons non synthetise : ", error);
+      return E_FAIL;
+    }
+    WMT::Reference<WMT::Library> lib(handle);
+    dispatch = lib.newFunction(reflection.entry_point);
+    if (!dispatch) {
+      ERR("ambre-dx12: fonction ", reflection.entry_point, " absente du noyau de lancement");
+      return E_FAIL;
+    }
+  }
+  std::vector<obj_handle_t> function_handles;
+  for (auto &f : functions)
+    function_handles.push_back(f.handle);
+  WMTRayTracingPipelineInfo pipeline;
+  memset(&pipeline, 0, sizeof(pipeline));
+  pipeline.dispatch_function = dispatch.handle;
+  pipeline.functions.set(function_handles.data());
+  pipeline.function_count = (uint32_t)function_handles.size();
+  pipeline.max_call_stack_depth = 8 + 4 * max_recursion_depth;
+  obj_handle_t table_handle = 0;
+  WMT::Reference<WMT::Error> err;
+  pso = metal.newRayTracingPipeline(pipeline, table_handle, table_id, err);
+  table = WMT::Reference<WMT::Resource>(table_handle);
+  if (!pso) {
+    ERR("ambre-dx12: pipeline de ray tracing refuse par Metal : ", err.description().getUTF8String());
+    return E_FAIL;
+  }
+
+  // -- 5. Identifiants.
+  auto identifier = [](uint64_t intersection, uint64_t shader) {
+    std::array<uint8_t, 32> id{};
+    memcpy(id.data(), &intersection, 8);
+    memcpy(id.data() + 8, &shader, 8);
+    return id;
+  };
+  for (auto &[name, handle] : handle_by_export) {
+    auto stage = stage_by_export[name];
+    if (stage == kStageRayGeneration || stage == kStageMiss || stage == kStageCallable)
+      identifiers[name] = identifier(0, handle);
+  }
+  for (auto &g : hit_groups) {
+    uint64_t closest = 0;
+    if (!g.closest_hit.empty()) {
+      auto found = handle_by_export.find(g.closest_hit);
+      if (found != handle_by_export.end())
+        closest = found->second;
+    }
+    identifiers[g.name] = identifier(0, closest);
+  }
+  static std::atomic<uint32_t> created = 0;
+  if (created++ < 20)
+    WARN("ambre-dx12: objet d'etat de ray tracing cree : ", functions.size(), " shaders, ", hit_groups.size(),
+         " groupes de touche");
+  return S_OK;
+}
+
+HRESULT
+CreateRTStateObject(MTLD3D12Device *pDevice, const D3D12_STATE_OBJECT_DESC *pDesc, REFIID riid, void **ppStateObject) {
+  auto object = Com(new MTLD3D12RTStateObject(pDevice));
+  HRESULT hr = object->Initialize(pDesc);
+  if (FAILED(hr))
+    return hr;
+  if (!ppStateObject)
+    return S_FALSE;
+  return object->QueryInterface(riid, ppStateObject);
+}
+
+} // namespace dxmt
