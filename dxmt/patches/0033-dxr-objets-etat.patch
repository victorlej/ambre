 );
+/* Facultative (ray tracing) :
+     int ambre_dxil_rt_convert(const struct WMTIRRTCompileInfo *, struct WMTIRRTReflection *, void **metallib,
+                               size_t *size, char *error, size_t error_size); */
+typedef int (*ambre_dxil_rt_convert_fn)(
