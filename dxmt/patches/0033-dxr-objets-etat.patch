+WINEMETAL_API obj_handle_t
+IRConverter_newRayTracingLibrary(
+    obj_handle_t device, const struct WMTIRRTCompileInfo *info, struct WMTIRRTReflection *reflection, char *error,
+    uint64_t error_size
+) {
+  struct unixcall_irconverter_newrtlibrary params;
+  params.device = device;
+  WMT_MEMPTR_SET(params.info, info);
+  WMT_MEMPTR_SET(params.reflection, reflection);
+  WMT_MEMPTR_SET(params.error, error);
+  params.error_size = error_size;
+  params.ret_library = 0;
+  if (error && error_size)
+    error[0] = 0;
+  if (UNIX_CALL(154, &params))
+    return 0;
+  return params.ret_library;
+}
+
+WINEMETAL_API obj_handle_t
+MTLDevice_newRayTracingPipeline(
+    obj_handle_t device, const struct WMTRayTracingPipelineInfo *info, obj_handle_t *table_out,
+    uint64_t *table_id_out, obj_handle_t *err_out
+) {
+  struct unixcall_mtldevice_newrtpso params;
+  params.device = device;
+  WMT_MEMPTR_SET(params.info, info);
+  params.ret_pso = 0;
+  params.ret_table = 0;
+  params.ret_table_id = 0;
+  params.ret_error = 0;
+  if (UNIX_CALL(155, &params))
+    return 0;
+  if (table_out)
+    *table_out = params.ret_table;
+  if (table_id_out)
+    *table_id_out = params.ret_table_id;
+  if (err_out)
+    *err_out = params.ret_error;
+  return params.ret_pso;
+}
