+// Ambre : taille de la mémoire vidéo (Ko), lue sur la puce Metal ; GTA V Enhanced la demande.
+static NvU32
+AmbreFrameBufferKB(NvPhysicalGpuHandle hPhysicalGpu) {
+  auto devices = WMT::CopyAllDevices();
+  for (unsigned i = 0; i < devices.count(); i++)
+    if ((NvPhysicalGpuHandle)devices.object(i).registryID() == hPhysicalGpu)
+      return NvU32(devices.object(i).recommendedMaxWorkingSetSize() / 1024);
+  return 0;
+}
+
+NVAPI_INTERFACE
+NvAPI_GPU_GetPhysicalFrameBufferSize(NvPhysicalGpuHandle hPhysicalGpu, NvU32 *pSize) {
+  if (!hPhysicalGpu || !pSize)
+    return NVAPI_INVALID_ARGUMENT;
+  if (!(*pSize = AmbreFrameBufferKB(hPhysicalGpu)))
+    return NVAPI_EXPECTED_PHYSICAL_GPU_HANDLE;
+  return NVAPI_OK;
+}
+
+NVAPI_INTERFACE
+NvAPI_GPU_GetVirtualFrameBufferSize(NvPhysicalGpuHandle hPhysicalGpu, NvU32 *pSize) {
+  if (!hPhysicalGpu || !pSize)
+    return NVAPI_INVALID_ARGUMENT;
+  if (!(*pSize = AmbreFrameBufferKB(hPhysicalGpu)))
+    return NVAPI_EXPECTED_PHYSICAL_GPU_HANDLE;
+  return NVAPI_OK;
+}
+
+NVAPI_INTERFACE
+NvAPI_GetLogicalGPUFromPhysicalGPU(NvPhysicalGpuHandle hPhysicalGpu, NvLogicalGpuHandle *pLogicalGpu) {
+  if (!hPhysicalGpu || !pLogicalGpu)
+    return NVAPI_INVALID_ARGUMENT;
+  // Ambre : un GPU logique par GPU physique, même identifiant (voir NvAPI_GPU_GetLogicalGpuInfo).
+  *pLogicalGpu = (NvLogicalGpuHandle)hPhysicalGpu;
+  return NVAPI_OK;
+}
