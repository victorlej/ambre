diff --git a/src/d3d12/d3d12_raytracing.hpp b/src/d3d12/d3d12_raytracing.hpp
new file mode 100644
index 0000000..3172ed5
--- /dev/null
+++ b/src/d3d12/d3d12_raytracing.hpp
@@ -0,0 +1,81 @@
+/*
+ * Ambre : DirectX Raytracing sur Metal (correctif 0032, structures d'accélération).
+ *
+ * Fonctions communes à la question de taille du périphérique (GetRaytracingAccelerationStructure
+ * PrebuildInfo) et à la construction (BuildRaytracingAccelerationStructure).
+ *
+ * Ce fichier suit la licence de DXMT (LGPL 2.1).
+ */
+
+#pragma once
+
+#include "d3d12_device.hpp"
+#include <cstring>
+
+namespace dxmt {
+
+// AMBRE_DXR=1 : ray tracing exposé aux jeux (essais ; défini dans d3d12_device.cpp).
+bool AmbreDxrEnabled();
+
+// Tailles de l'en-tête écrit dans le tampon de l'application (un niveau haut y tient avec le tableau
+// des contributions d'instances) : voir IRRaytracingAccelerationStructureGPUHeader du convertisseur.
+constexpr uint64_t kAmbreAccelHeaderSize = 64;
+
+inline uint64_t
+AmbreAccelAlign256(uint64_t value) {
+  return (value + 255) & ~uint64_t(255);
+}
+
+inline uint32_t
+AmbreAccelUsage(D3D12_RAYTRACING_ACCELERATION_STRUCTURE_BUILD_FLAGS flags) {
+  uint32_t usage = 0;
+  if (flags & D3D12_RAYTRACING_ACCELERATION_STRUCTURE_BUILD_FLAG_ALLOW_UPDATE)
+    usage |= 1;
+  if (flags & D3D12_RAYTRACING_ACCELERATION_STRUCTURE_BUILD_FLAG_PREFER_FAST_BUILD)
+    usage |= 2;
+  return usage;
+}
+
+// Remplit une géométrie Metal à partir d'une géométrie DXR. `resolve(VA, &offset)` rend le tampon
+// Metal qui contient l'adresse (0 s'il est introuvable).
+template <typename Resolve>
+inline bool
+AmbreFillGeometry(const D3D12_RAYTRACING_GEOMETRY_DESC &d, WMTAccelGeometry &g, Resolve &&resolve) {
+  memset(&g, 0, sizeof(g));
+  g.opaque = (d.Flags & D3D12_RAYTRACING_GEOMETRY_FLAG_OPAQUE) ? 1 : 0;
+  g.no_duplicate_any_hit = (d.Flags & D3D12_RAYTRACING_GEOMETRY_FLAG_NO_DUPLICATE_ANYHIT_INVOCATION) ? 1 : 0;
+  uint64_t offset = 0;
+  if (d.Type == D3D12_RAYTRACING_GEOMETRY_TYPE_PROCEDURAL_PRIMITIVE_AABBS) {
+    g.kind = 1;
+    g.primitive_count = (uint32_t)d.AABBs.AABBCount;
+    g.box_stride = (uint32_t)d.AABBs.AABBs.StrideInBytes;
+    g.box_buffer = resolve(d.AABBs.AABBs.StartAddress, &offset);
+    g.box_offset = offset;
+    return g.box_buffer != 0 && g.primitive_count != 0;
+  }
+  const auto &t = d.Triangles;
+  g.kind = 0;
+  g.vertex_format = (uint32_t)t.VertexFormat;
+  g.vertex_stride = (uint32_t)t.VertexBuffer.StrideInBytes;
+  g.vertex_buffer = resolve(t.VertexBuffer.StartAddress, &offset);
+  g.vertex_offset = offset;
+  if (t.IndexFormat == DXGI_FORMAT_R16_UINT || t.IndexFormat == DXGI_FORMAT_R32_UINT) {
+    g.index_type = t.IndexFormat == DXGI_FORMAT_R16_UINT ? 1 : 2;
+    g.primitive_count = t.IndexCount / 3;
+    offset = 0;
+    g.index_buffer = resolve(t.IndexBuffer, &offset);
+    g.index_offset = offset;
+    if (!g.index_buffer)
+      return false;
+  } else {
+    g.primitive_count = t.VertexCount / 3;
+  }
+  if (t.Transform3x4) {
+    offset = 0;
+    g.transform_buffer = resolve(t.Transform3x4, &offset);
+    g.transform_offset = offset;
+  }
+  return g.vertex_buffer != 0 && g.primitive_count != 0;
+}
+
+} // namespace dxmt
