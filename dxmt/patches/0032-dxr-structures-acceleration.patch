+  // Écrit jusqu'à six mots de 64 bits à une adresse GPU (en-tête, informations de fin de construction).
+  void
+  AmbreAccelWriteWords(D3D12_GPU_VIRTUAL_ADDRESS VA, const uint64_t *Values, uint32_t Count) {
+    if (!VA || !Count || Count > 6)
+      return;
+    auto &pipelines = AmbreAccel(device_->GetMTLDevice());
+    AmbreAccelWriteArgs args = {};
+    args.dst = VA;
+    for (uint32_t i = 0; i < Count; i++)
+      args.values[i] = Values[i];
+    args.count = Count;
+    AmbreAccelCompute(pipelines.write, &args, sizeof(args), Count);
+  }
+
+  void
+  AmbreAccelBeginPass() {
+    allocator_->InvalidateCurrentPass();
+    auto accel = allocator_->AllocatePass<AccelEncoderData>();
+    accel->type = EncoderType::Accel;
+    accel->cmd_head.type = WMTAccelCommandNop;
+    accel->cmd_head.next.set(0);
+    accel->cmd_tail = (wmtcmd_base *)&accel->cmd_head;
+  }
+
+  // Valeur annoncée pour COMPACTED_SIZE / CURRENT_SIZE : la taille du tampon que nous demandons.
+  static uint64_t
+  AmbreAccelResultSize(const AmbreAccelStructure &Accel) {
+    return AmbreAccelAlign256(Accel.top_level ? kAmbreAccelHeaderSize + 4ull * Accel.instance_capacity : kAmbreAccelHeaderSize);
+  }
+
+  void
+  AmbreAccelPostbuild(
+      UINT Count, const D3D12_RAYTRACING_ACCELERATION_STRUCTURE_POSTBUILD_INFO_DESC *pDescs, uint64_t Value
+  ) {
+    for (UINT i = 0; i < Count; i++) {
+      uint64_t words[6] = {};
+      uint32_t count = 0;
+      switch (pDescs[i].InfoType) {
+      case D3D12_RAYTRACING_ACCELERATION_STRUCTURE_POSTBUILD_INFO_COMPACTED_SIZE:
+      case D3D12_RAYTRACING_ACCELERATION_STRUCTURE_POSTBUILD_INFO_CURRENT_SIZE:
+        words[0] = Value;
+        count = 1;
+        break;
+      case D3D12_RAYTRACING_ACCELERATION_STRUCTURE_POSTBUILD_INFO_TOOLS_VISUALIZATION:
+        count = 2; // taille sérialisée et nombre de niveaux bas : zéro
+        break;
+      case D3D12_RAYTRACING_ACCELERATION_STRUCTURE_POSTBUILD_INFO_SERIALIZATION:
+        count = 6; // identifiants du pilote (32 octets), taille, nombre de pointeurs : zéro
+        break;
+      default:
+        continue;
+      }
+      AmbreAccelWriteWords(pDescs[i].DestBuffer, words, count);
+    }
+  }
