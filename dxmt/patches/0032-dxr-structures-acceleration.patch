+// Ambre : DirectX Raytracing — petits noyaux de calcul internes.
+//  - ambre_accel_instances : convertit les instances d'un niveau haut (D3D12_RAYTRACING_INSTANCE_DESC,
+//    64 octets, adresse du niveau bas) en instances Metal « indirectes » (72 octets, identifiant du
+//    niveau bas lu dans l'en-tête que sa construction a écrit à son adresse), et écrit l'en-tête du
+//    niveau haut (identifiant + adresse du tableau des contributions) au format du convertisseur
+//    d'Apple, suivi du tableau des contributions.
+//  - ambre_accel_write : écrit quelques mots de 64 bits (en-tête d'un niveau bas, informations de
+//    fin de construction).
+static const char kAmbreAccelSource[] = R"(
+#include <metal_stdlib>
+using namespace metal;
+struct AmbreAccelInstanceArgs {
+  device const uchar *src;
+  device uchar *dst;
+  device uchar *header;
+  ulong header_va;
+  ulong tlas_id;
+  ulong fallback_id;
+  uint count;
+  uint pointers;
+};
+kernel void ambre_accel_instances(uint tid [[thread_position_in_grid]], constant AmbreAccelInstanceArgs &a [[buffer(30)]]) {
+  if (tid == 0) {
+    device ulong *h = (device ulong *)a.header;
+    h[0] = a.tlas_id;
+    h[1] = a.header_va + 64;
+    for (uint i = 2; i < 8; i++)
+      h[i] = 0;
+  }
+  if (tid >= a.count)
+    return;
+  device const uchar *s = a.src + ulong(tid) * 64;
+  if (a.pointers != 0) {
+    ulong p = ((device const ulong *)a.src)[tid];
+    s = (device const uchar *)p;
+  }
+  device const float *m = (device const float *)s;
+  device float *o = (device float *)(a.dst + ulong(tid) * 72);
+  for (uint c = 0; c < 4; c++)
+    for (uint r = 0; r < 3; r++)
+      o[c * 3 + r] = m[r * 4 + c];
+  uint w0 = *(device const uint *)(s + 48);
+  uint w1 = *(device const uint *)(s + 52);
+  ulong va = *(device const ulong *)(s + 56);
+  uint mask = w0 >> 24;
+  ulong id = a.fallback_id;
+  if (va != 0) {
+    id = *(device const ulong *)va;
+    if (id == 0) {
+      id = a.fallback_id;
+      mask = 0;
+    }
+  } else {
+    mask = 0;
+  }
+  device uint *o32 = (device uint *)(a.dst + ulong(tid) * 72 + 48);
+  o32[0] = w1 >> 24;
+  o32[1] = mask;
+  o32[2] = 0;
+  o32[3] = w0 & 0xFFFFFFu;
+  *(device ulong *)(a.dst + ulong(tid) * 72 + 64) = id;
+  ((device uint *)(a.header + 64))[tid] = w1 & 0xFFFFFFu;
+}
+struct AmbreAccelWriteArgs {
+  device ulong *dst;
+  ulong values[6];
+  uint count;
+  uint pad;
+};
+kernel void ambre_accel_write(uint tid [[thread_position_in_grid]], constant AmbreAccelWriteArgs &a [[buffer(30)]]) {
+  if (tid < a.count)
+    a.dst[tid] = a.values[tid];
+}
+)";
+
+struct AmbreAccelPipelines {
+  WMT::Reference<WMT::ComputePipelineState> instances;
+  WMT::Reference<WMT::ComputePipelineState> write;
+  bool tried = false;
+};
+
+static AmbreAccelPipelines &
+AmbreAccel(WMT::Device device) {
+  static dxmt::mutex lock;
+  static std::map<obj_handle_t, AmbreAccelPipelines> all;
+  std::unique_lock<dxmt::mutex> guard(lock);
+  auto &pipelines = all[device.handle];
+  if (pipelines.tried)
+    return pipelines;
+  pipelines.tried = true;
+  WMT::Reference<WMT::Error> err;
+  auto library = device.newLibraryWithSource(std::string_view(kAmbreAccelSource, sizeof(kAmbreAccelSource) - 1), err);
+  if (!library) {
+    ERR("ambre-dx12: noyaux de structures d'acceleration non compiles : ", err.description().getUTF8String());
+    return pipelines;
+  }
+  auto instances = library.newFunction("ambre_accel_instances");
+  pipelines.instances = device.newComputePipelineState(instances, err);
+  auto write = library.newFunction("ambre_accel_write");
+  pipelines.write = device.newComputePipelineState(write, err);
+  if (!pipelines.instances || !pipelines.write)
+    ERR("ambre-dx12: noyaux de structures d'acceleration incomplets");
+  return pipelines;
+}
+
+struct AmbreAccelInstanceArgs {
+  uint64_t src;
+  uint64_t dst;
+  uint64_t header;
+  uint64_t header_va;
+  uint64_t tlas_id;
+  uint64_t fallback_id;
+  uint32_t count;
+  uint32_t pointers;
+};
+
+struct AmbreAccelWriteArgs {
+  uint64_t dst;
+  uint64_t values[6];
+  uint32_t count;
+  uint32_t pad;
+};
