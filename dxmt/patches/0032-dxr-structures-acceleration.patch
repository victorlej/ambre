+  void STDMETHODCALLTYPE
+  BuildRaytracingAccelerationStructure(
+      const D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_DESC *pDesc, UINT NumPostbuildInfoDescs,
+      const D3D12_RAYTRACING_ACCELERATION_STRUCTURE_POSTBUILD_INFO_DESC *pPostbuildInfoDescs
+  ) {
+    static std::atomic<uint32_t> warned = 0;
+    if (!pDesc || !pDesc->DestAccelerationStructureData)
+      return;
+    const auto &in = pDesc->Inputs;
+    bool top = in.Type == D3D12_RAYTRACING_ACCELERATION_STRUCTURE_TYPE_TOP_LEVEL;
+    bool update = (in.Flags & D3D12_RAYTRACING_ACCELERATION_STRUCTURE_BUILD_FLAG_PERFORM_UPDATE) != 0;
+    auto device = device_->GetMTLDevice();
+    auto &pipelines = AmbreAccel(device);
+    auto dummy = device_->AmbreDummyBuffer().handle;
+
+    WMTAccelDescriptor desc;
+    memset(&desc, 0, sizeof(desc));
+    desc.usage = AmbreAccelUsage(in.Flags);
+    WMTAccelGeometry *geometries = nullptr;
+    if (top) {
+      desc.kind = 1;
+      desc.instance_count = in.NumDescs;
+      desc.instance_buffer = dummy;
+      if (!in.NumDescs || !in.InstanceDescs)
+        return;
+    } else {
+      if (!in.NumDescs)
+        return;
+      geometries = allocator_->AllocateCommandData<WMTAccelGeometry>(in.NumDescs);
+      unsigned valid = 0;
+      auto resolve = [&](D3D12_GPU_VIRTUAL_ADDRESS VA, uint64_t *offset) -> obj_handle_t {
+        auto allocation = device_->LookupBufferByVA(VA, offset);
+        return allocation ? allocation->buffer().handle : 0;
+      };
+      for (unsigned i = 0; i < in.NumDescs; i++) {
+        const D3D12_RAYTRACING_GEOMETRY_DESC *g = in.DescsLayout == D3D12_ELEMENTS_LAYOUT_ARRAY
+                                                      ? &in.pGeometryDescs[i]
+                                                      : in.ppGeometryDescs[i];
+        if (g && AmbreFillGeometry(*g, geometries[valid], resolve))
+          valid++;
+        else if (warned++ < 10)
+          WARN("ambre-dx12: geometrie DXR ignoree (tampon introuvable ou vide)");
+      }
+      if (!valid)
+        return;
+      desc.geometry_count = valid;
+      desc.geometries.set(geometries);
+    }
+
+    auto sizes = device.accelerationStructureSizes(desc);
+    if (!sizes.structure_size) {
+      if (warned++ < 10)
+        WARN("ambre-dx12: taille de structure d'acceleration nulle : construction sautee");
+      return;
+    }
+
+    // Tampon d'échafaudage fourni par le jeu.
+    uint64_t scratch_offset = 0;
+    obj_handle_t scratch = 0;
+    if (auto allocation = device_->LookupBufferByVA(pDesc->ScratchAccelerationStructureData, &scratch_offset))
+      scratch = allocation->buffer().handle;
+    if (!scratch) {
+      if (warned++ < 10)
+        WARN("ambre-dx12: tampon d'echafaudage introuvable : construction sautee");
+      return;
+    }
+
+    auto source = update ? device_->AmbreGetAccel(pDesc->SourceAccelerationStructureData) : nullptr;
+    if (update && !source) {
+      if (warned++ < 10)
+        WARN("ambre-dx12: mise a jour d'une structure inconnue : construction complete");
+      update = false;
+    }
+    std::shared_ptr<AmbreAccelStructure> accel;
+    if (update && pDesc->SourceAccelerationStructureData == pDesc->DestAccelerationStructureData) {
+      accel = source;
+    } else {
+      auto existing = device_->AmbreGetAccel(pDesc->DestAccelerationStructureData);
+      // Pas de réutilisation si la structure est partagée (copie « compactée » par alias).
+      if (existing && existing->top_level == top && existing->size >= sizes.structure_size && existing.use_count() <= 2) {
+        accel = existing;
+      } else {
+        accel = std::make_shared<AmbreAccelStructure>();
+        accel->structure = device.newAccelerationStructure(sizes.structure_size);
+        if (!accel->structure) {
+          ERR("ambre-dx12: structure d'acceleration non creee (", sizes.structure_size, " octets)");
+          return;
+        }
+        accel->resource_id = accel->structure.gpuResourceID();
+        accel->size = sizes.structure_size;
+        accel->top_level = top;
+      }
+    }
+
+    if (top) {
+      if (accel->instance_capacity < in.NumDescs || !accel->instances) {
+        uint32_t capacity = std::max<uint32_t>(in.NumDescs, accel->instance_capacity ? accel->instance_capacity * 2 : 1024);
+        WMTBufferInfo info;
+        info.memory.set(nullptr);
+        info.length = uint64_t(capacity) * WMT_ACCEL_INSTANCE_STRIDE;
+        info.options = (WMTResourceOptions)(WMTResourceStorageModePrivate | WMTResourceHazardTrackingModeUntracked);
+        info.gpu_address = 0;
+        auto buffer = device.newBuffer(info);
+        if (!buffer) {
+          ERR("ambre-dx12: tampon des instances non cree (", capacity, " instances)");
+          return;
+        }
+        device_->RegisterResidency(WMT::Allocation{buffer.handle});
+        if (accel->instances)
+          accel->retired.push_back(accel->instances);
+        accel->instances = buffer;
+        accel->instances_address = info.gpu_address;
+        accel->instance_capacity = capacity;
+      }
+      desc.instance_buffer = accel->instances.handle;
+      desc.instance_offset = 0;
+      // Conversion des instances (et en-tête) : avant la construction.
+      AmbreAccelInstanceArgs args = {};
+      args.src = in.InstanceDescs;
+      args.dst = accel->instances_address;
+      args.header = pDesc->DestAccelerationStructureData;
+      args.header_va = pDesc->DestAccelerationStructureData;
+      args.tlas_id = accel->resource_id;
+      args.fallback_id = device_->AmbreLastBottomLevelID();
+      args.count = in.NumDescs;
+      args.pointers = in.DescsLayout == D3D12_ELEMENTS_LAYOUT_ARRAY_OF_POINTERS ? 1 : 0;
+      AmbreAccelCompute(pipelines.instances, &args, sizeof(args), in.NumDescs);
+    } else {
+      uint64_t words[1] = {accel->resource_id};
+      AmbreAccelWriteWords(pDesc->DestAccelerationStructureData, words, 1);
+    }
+
+    AmbreAccelBeginPass();
+    auto &cmd = allocator_->EncodeAccelCommand<wmtcmd_accel_build>();
+    cmd.type = WMTAccelCommandBuild;
+    cmd.descriptor = desc;
+    cmd.dst = accel->structure.handle;
+    cmd.src = update ? source->structure.handle : 0;
+    cmd.scratch = scratch;
+    cmd.scratch_offset = scratch_offset;
+    allocator_->InvalidateCurrentPass();
+
+    device_->AmbreSetAccel(pDesc->DestAccelerationStructureData, accel);
+    if (NumPostbuildInfoDescs)
+      AmbreAccelPostbuild(NumPostbuildInfoDescs, pPostbuildInfoDescs, AmbreAccelResultSize(*accel));
+  }
+
+  void STDMETHODCALLTYPE
+  EmitRaytracingAccelerationStructurePostbuildInfo(
+      const D3D12_RAYTRACING_ACCELERATION_STRUCTURE_POSTBUILD_INFO_DESC *pDesc, UINT SourceCount,
+      const D3D12_GPU_VIRTUAL_ADDRESS *pSources
+  ) {
+    if (!pDesc || !pSources)
+      return;
+    uint64_t stride = 8;
+    switch (pDesc->InfoType) {
+    case D3D12_RAYTRACING_ACCELERATION_STRUCTURE_POSTBUILD_INFO_TOOLS_VISUALIZATION:
+      stride = 16;
+      break;
+    case D3D12_RAYTRACING_ACCELERATION_STRUCTURE_POSTBUILD_INFO_SERIALIZATION:
+      stride = 48;
+      break;
+    default:
+      break;
+    }
+    for (UINT i = 0; i < SourceCount; i++) {
+      auto accel = device_->AmbreGetAccel(pSources[i]);
+      D3D12_RAYTRACING_ACCELERATION_STRUCTURE_POSTBUILD_INFO_DESC one = *pDesc;
+      one.DestBuffer = pDesc->DestBuffer + i * stride;
+      AmbreAccelPostbuild(1, &one, accel ? AmbreAccelResultSize(*accel) : 0);
+    }
+  }
