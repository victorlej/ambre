diff --git a/src/winemetal/winemetal.h b/src/winemetal/winemetal.h
index d39935c..dda3283 100644
--- a/src/winemetal/winemetal.h
+++ b/src/winemetal/winemetal.h
@@ -2283,4 +2283,97 @@ WINEMETAL_API void MTLTexture_getBytes(
     struct WMTMemoryPointer data, uint64_t bytes_per_row, uint64_t bytes_per_image
 );
 
+/* Ambre : structures d'accélération (DirectX Raytracing -> Metal). Une géométrie est décrite
+   avec des tampons et des décalages déjà résolus ; vertex_format est un DXGI_FORMAT. */
+struct WMTAccelGeometry {
+  uint32_t kind;                 /* 0 : triangles, 1 : boîtes englobantes */
+  uint32_t opaque;               /* 1 : sans shader de touche */
+  uint32_t no_duplicate_any_hit; /* 1 : une seule invocation du shader de touche */
+  uint32_t vertex_format;        /* DXGI_FORMAT des positions */
+  uint32_t vertex_stride;
+  uint32_t index_type;           /* 0 : aucun, 1 : 16 bits, 2 : 32 bits */
+  uint32_t primitive_count;      /* triangles ou boîtes */
+  uint32_t intersection_offset;
+  obj_handle_t vertex_buffer;
+  uint64_t vertex_offset;
+  obj_handle_t index_buffer;
+  uint64_t index_offset;
+  obj_handle_t transform_buffer; /* matrice 3x4 ligne par ligne, ou 0 */
+  uint64_t transform_offset;
+  obj_handle_t box_buffer;
+  uint64_t box_offset;
+  uint32_t box_stride;
+  uint32_t padding;
+};
+
+struct WMTAccelDescriptor {
+  uint32_t kind;  /* 0 : primitives (niveau bas), 1 : instances (niveau haut) */
+  uint32_t usage; /* bit 0 : mise à jour possible, bit 1 : construction rapide */
+  uint32_t geometry_count;
+  uint32_t instance_count;
+  struct WMTConstMemoryPointer geometries; /* struct WMTAccelGeometry[geometry_count] */
+  obj_handle_t instance_buffer;            /* MTLIndirectAccelerationStructureInstanceDescriptor[] */
+  uint64_t instance_offset;
+};
+
+struct WMTAccelSizes {
+  uint64_t structure_size;
+  uint64_t build_scratch_size;
+  uint64_t refit_scratch_size;
+};
+
+#define WMT_ACCEL_INSTANCE_STRIDE 72
+
+WINEMETAL_API void MTLDevice_accelerationStructureSizes(
+    obj_handle_t device, const struct WMTAccelDescriptor *descriptor, struct WMTAccelSizes *sizes
+);
+WINEMETAL_API obj_handle_t MTLDevice_newAccelerationStructure(obj_handle_t device, uint64_t size);
+WINEMETAL_API uint64_t MTLAccelerationStructure_gpuResourceID(obj_handle_t structure);
+WINEMETAL_API obj_handle_t MTLCommandBuffer_accelerationStructureCommandEncoder(obj_handle_t cmdbuf);
+
+enum WMTAccelCommandType : uint16_t {
+  WMTAccelCommandNop,
+  WMTAccelCommandBuild,
+  WMTAccelCommandCopy,
+  WMTAccelCommandWaitForFence,
+  WMTAccelCommandUpdateFence,
+};
+
+struct wmtcmd_accel_nop {
+  enum WMTAccelCommandType type;
+  uint16_t reserved[3];
+  struct WMTMemoryPointer next;
+};
+
+struct wmtcmd_accel_build {
+  enum WMTAccelCommandType type;
+  uint16_t reserved[3];
+  struct WMTMemoryPointer next;
+  struct WMTAccelDescriptor descriptor;
+  obj_handle_t dst;
+  obj_handle_t src; /* mise à jour (refit) : structure source ; 0 : construction */
+  obj_handle_t scratch;
+  uint64_t scratch_offset;
+};
+
+struct wmtcmd_accel_copy {
+  enum WMTAccelCommandType type;
+  uint16_t reserved[3];
+  struct WMTMemoryPointer next;
+  obj_handle_t src;
+  obj_handle_t dst;
+};
+
+struct wmtcmd_accel_fence_op {
+  enum WMTAccelCommandType type;
+  uint16_t reserved[3];
+  struct WMTMemoryPointer next;
+  obj_handle_t fence;
+};
+
+WINEMETAL_API void MTLAccelerationStructureCommandEncoder_encodeCommands(
+    obj_handle_t encoder, const struct wmtcmd_base *cmd_head
+);
+
+
 #endif
