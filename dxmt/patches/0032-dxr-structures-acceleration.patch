+
+  // Passe de calcul interne : un noyau MSL, ses arguments en constante (emplacement 30).
+  void
+  AmbreAccelCompute(WMT::ComputePipelineState Pso, const void *Args, size_t Size, uint32_t Threads) {
+    if (!Pso || !Threads)
+      return;
+    if (!allocator_->encoder_current || allocator_->encoder_current->type != EncoderType::Compute) {
+      allocator_->InvalidateCurrentPass();
+      auto compute = allocator_->AllocatePass<ComputeEncoderData>();
+      compute->type = EncoderType::Compute;
+      compute->cmd_head.type = WMTComputeCommandNop;
+      compute->cmd_head.next.set(0);
+      compute->cmd_tail = (wmtcmd_base *)&compute->cmd_head;
+    }
+    auto [Params, ParamsOffset] = allocator_->AllocateGPUHeap(Size, 16);
+    memcpy(Params, Args, Size);
+    auto &setpso = allocator_->EncodeComputeCommand<wmtcmd_compute_setpso>();
+    setpso.type = WMTComputeCommandSetPSO;
+    setpso.pso = Pso.handle;
+    setpso.threadgroup_size = {64, 1, 1};
+    auto &setbuf = allocator_->EncodeComputeCommand<wmtcmd_compute_setbuffer>();
+    setbuf.type = WMTComputeCommandSetBuffer;
+    setbuf.buffer = allocator_->gpu_heap_buffer_.handle;
+    setbuf.offset = ParamsOffset;
+    setbuf.index = 30;
+    auto &run = allocator_->EncodeComputeCommand<wmtcmd_compute_dispatch>();
+    run.type = WMTComputeCommandDispatchThreads;
+    run.size = {Threads, 1, 1};
+    // Les calculs du jeu repartent d'un état propre.
+    dirty_state_.set(DirtyState::ComputeRootArguments, DirtyState::ComputeRootSignature);
+    dirty_state_.set(DirtyState::ComputePipelineState);
+    allocator_->InvalidateCurrentPass();
+  }
