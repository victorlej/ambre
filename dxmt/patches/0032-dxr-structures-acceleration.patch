+/* Ambre : structures d'accélération (DirectX Raytracing). */
+static MTLAttributeFormat
+ambre_accel_vertex_format(uint32_t dxgi) {
+  switch (dxgi) {
+  case 6: /* R32G32B32_FLOAT */
+    return MTLAttributeFormatFloat3;
+  case 16: /* R32G32_FLOAT */
+    return MTLAttributeFormatFloat2;
+  case 10: /* R16G16B16A16_FLOAT */
+    return MTLAttributeFormatHalf4;
+  case 34: /* R16G16_FLOAT */
+    return MTLAttributeFormatHalf2;
+  case 13: /* R16G16B16A16_SNORM */
+    return MTLAttributeFormatShort4Normalized;
+  case 37: /* R16G16_SNORM */
+    return MTLAttributeFormatShort2Normalized;
+  case 11: /* R16G16B16A16_UNORM */
+    return MTLAttributeFormatUShort4Normalized;
+  case 35: /* R16G16_UNORM */
+    return MTLAttributeFormatUShort2Normalized;
+  case 28: /* R8G8B8A8_UNORM */
+    return MTLAttributeFormatUChar4Normalized;
+  case 31: /* R8G8B8A8_SNORM */
+    return MTLAttributeFormatChar4Normalized;
+  case 49: /* R8G8_UNORM */
+    return MTLAttributeFormatUChar2Normalized;
+  case 51: /* R8G8_SNORM */
+    return MTLAttributeFormatChar2Normalized;
+  case 24: /* R10G10B10A2_UNORM */
+    return MTLAttributeFormatUInt1010102Normalized;
+  default:
+    return MTLAttributeFormatFloat3;
+  }
+}
+
+static MTLAccelerationStructureDescriptor *
+ambre_accel_descriptor(const struct WMTAccelDescriptor *desc) {
+  MTLAccelerationStructureUsage usage = MTLAccelerationStructureUsageNone;
+  if (desc->usage & 1)
+    usage |= MTLAccelerationStructureUsageRefit;
+  if (desc->usage & 2)
+    usage |= MTLAccelerationStructureUsagePreferFastBuild;
+  if (desc->kind == 1) {
+    MTLInstanceAccelerationStructureDescriptor *instance = [MTLInstanceAccelerationStructureDescriptor descriptor];
+    instance.instanceDescriptorType = MTLAccelerationStructureInstanceDescriptorTypeIndirect;
+    instance.instanceCount = desc->instance_count;
+    instance.instanceDescriptorBuffer = (id<MTLBuffer>)desc->instance_buffer;
+    instance.instanceDescriptorBufferOffset = desc->instance_offset;
+    instance.instanceDescriptorStride = WMT_ACCEL_INSTANCE_STRIDE;
+    instance.usage = usage;
+    return instance;
+  }
+  MTLPrimitiveAccelerationStructureDescriptor *primitive = [MTLPrimitiveAccelerationStructureDescriptor descriptor];
+  NSMutableArray<MTLAccelerationStructureGeometryDescriptor *> *geometries = [NSMutableArray array];
+  const struct WMTAccelGeometry *items = desc->geometries.ptr;
+  for (uint32_t i = 0; i < desc->geometry_count; i++) {
+    const struct WMTAccelGeometry *g = &items[i];
+    MTLAccelerationStructureGeometryDescriptor *base = nil;
+    if (g->kind == 1) {
+      MTLAccelerationStructureBoundingBoxGeometryDescriptor *box =
+          [MTLAccelerationStructureBoundingBoxGeometryDescriptor descriptor];
+      box.boundingBoxBuffer = (id<MTLBuffer>)g->box_buffer;
+      box.boundingBoxBufferOffset = g->box_offset;
+      box.boundingBoxStride = g->box_stride ? g->box_stride : 24;
+      box.boundingBoxCount = g->primitive_count;
+      base = box;
+    } else {
+      MTLAccelerationStructureTriangleGeometryDescriptor *triangles =
+          [MTLAccelerationStructureTriangleGeometryDescriptor descriptor];
+      triangles.vertexBuffer = (id<MTLBuffer>)g->vertex_buffer;
+      triangles.vertexBufferOffset = g->vertex_offset;
+      triangles.vertexStride = g->vertex_stride;
+      triangles.vertexFormat = ambre_accel_vertex_format(g->vertex_format);
+      if (g->index_type) {
+        triangles.indexBuffer = (id<MTLBuffer>)g->index_buffer;
+        triangles.indexBufferOffset = g->index_offset;
+        triangles.indexType = g->index_type == 1 ? MTLIndexTypeUInt16 : MTLIndexTypeUInt32;
+      }
+      triangles.triangleCount = g->primitive_count;
+      if (g->transform_buffer) {
+        triangles.transformationMatrixBuffer = (id<MTLBuffer>)g->transform_buffer;
+        triangles.transformationMatrixBufferOffset = g->transform_offset;
+        if (@available(macOS 15.0, *))
+          triangles.transformationMatrixLayout = MTLMatrixLayoutRowMajor;
+      }
+      base = triangles;
+    }
+    base.opaque = g->opaque ? YES : NO;
+    base.allowDuplicateIntersectionFunctionInvocation = g->no_duplicate_any_hit ? NO : YES;
+    base.intersectionFunctionTableOffset = g->intersection_offset;
+    [geometries addObject:base];
+  }
+  primitive.geometryDescriptors = geometries;
+  primitive.usage = usage;
+  return primitive;
+}
+
+static NTSTATUS
+_MTLDevice_accelerationStructureSizes(void *obj) {
+  struct unixcall_mtldevice_accelsizes *params = obj;
+  const struct WMTAccelDescriptor *desc = params->descriptor.ptr;
+  struct WMTAccelSizes *out = params->sizes.ptr;
+  @autoreleasepool {
+    MTLAccelerationStructureSizes sizes =
+        [(id<MTLDevice>)params->device accelerationStructureSizesWithDescriptor:ambre_accel_descriptor(desc)];
+    out->structure_size = sizes.accelerationStructureSize;
+    out->build_scratch_size = sizes.buildScratchBufferSize;
+    out->refit_scratch_size = sizes.refitScratchBufferSize;
+  }
+  return STATUS_SUCCESS;
+}
+
+static NTSTATUS
+_MTLDevice_newAccelerationStructure(void *obj) {
+  struct unixcall_generic_obj_uint64_obj_ret *params = obj;
+  params->ret = (obj_handle_t)[(id<MTLDevice>)params->handle newAccelerationStructureWithSize:params->arg];
+  return STATUS_SUCCESS;
+}
+
+static NTSTATUS
+_MTLAccelerationStructure_gpuResourceID(void *obj) {
+  struct unixcall_generic_obj_uint64_ret *params = obj;
+  MTLResourceID resource_id = [(id<MTLAccelerationStructure>)params->handle gpuResourceID];
+  params->ret = *(uint64_t *)&resource_id;
+  return STATUS_SUCCESS;
+}
+
+static NTSTATUS
+_MTLCommandBuffer_accelerationStructureCommandEncoder(void *obj) {
+  struct unixcall_generic_obj_obj_ret *params = obj;
+  params->ret = (obj_handle_t)[(id<MTLCommandBuffer>)params->handle accelerationStructureCommandEncoder];
+  return STATUS_SUCCESS;
+}
+
+static NTSTATUS
+_MTLAccelerationStructureCommandEncoder_encodeCommands(void *obj) {
+  struct unixcall_generic_obj_cmd_noret *params = obj;
+  const struct wmtcmd_base *next = params->cmd_head.ptr;
+  id<MTLAccelerationStructureCommandEncoder> encoder = (id<MTLAccelerationStructureCommandEncoder>)params->encoder;
+  while (next) {
+    switch ((enum WMTAccelCommandType)next->type) {
+    default:
+      assert(!next->type && "unhandled acceleration structure command type");
+      break;
+    case WMTAccelCommandBuild: {
+      struct wmtcmd_accel_build *body = (struct wmtcmd_accel_build *)next;
+      @autoreleasepool {
+        MTLAccelerationStructureDescriptor *descriptor = ambre_accel_descriptor(&body->descriptor);
+        if (body->src) {
+          id<MTLAccelerationStructure> source = (id<MTLAccelerationStructure>)body->src;
+          id<MTLAccelerationStructure> destination = (id<MTLAccelerationStructure>)body->dst;
+          [encoder refitAccelerationStructure:source
+                                   descriptor:descriptor
+                                  destination:(destination == source ? nil : destination)
+                                scratchBuffer:(id<MTLBuffer>)body->scratch
+                          scratchBufferOffset:body->scratch_offset];
+        } else {
+          [encoder buildAccelerationStructure:(id<MTLAccelerationStructure>)body->dst
+                                   descriptor:descriptor
+                                scratchBuffer:(id<MTLBuffer>)body->scratch
+                          scratchBufferOffset:body->scratch_offset];
+        }
+      }
+      break;
+    }
+    case WMTAccelCommandCopy: {
+      struct wmtcmd_accel_copy *body = (struct wmtcmd_accel_copy *)next;
+      [encoder copyAccelerationStructure:(id<MTLAccelerationStructure>)body->src
+                 toAccelerationStructure:(id<MTLAccelerationStructure>)body->dst];
+      break;
+    }
+    case WMTAccelCommandWaitForFence: {
+      struct wmtcmd_accel_fence_op *body = (struct wmtcmd_accel_fence_op *)next;
+      [encoder waitForFence:(id<MTLFence>)body->fence];
+      break;
+    }
+    case WMTAccelCommandUpdateFence: {
+      struct wmtcmd_accel_fence_op *body = (struct wmtcmd_accel_fence_op *)next;
+      [encoder updateFence:(id<MTLFence>)body->fence];
+      break;
+    }
+    }
+    next = next->next.ptr;
+  }
+  return STATUS_SUCCESS;
+}
