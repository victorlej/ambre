+  void STDMETHODCALLTYPE
+  CopyRaytracingAccelerationStructure(
+      D3D12_GPU_VIRTUAL_ADDRESS Dst, D3D12_GPU_VIRTUAL_ADDRESS Src, D3D12_RAYTRACING_ACCELERATION_STRUCTURE_COPY_MODE Mode
+  ) {
+    static std::atomic<uint32_t> warned = 0;
+    auto source = device_->AmbreGetAccel(Src);
+    if (!source || !Dst) {
+      if (warned++ < 10)
+        WARN("ambre-dx12: copie d'une structure d'acceleration inconnue");
+      return;
+    }
+    if (Mode == D3D12_RAYTRACING_ACCELERATION_STRUCTURE_COPY_MODE_COMPACT && !source->top_level) {
+      // Metal n'a pas besoin de la copie compacte : la structure est partagée.
+      device_->AmbreSetAccel(Dst, source);
+      uint64_t words[1] = {source->resource_id};
+      AmbreAccelWriteWords(Dst, words, 1);
+      return;
+    }
+    if (Mode == D3D12_RAYTRACING_ACCELERATION_STRUCTURE_COPY_MODE_CLONE && !source->top_level) {
+      auto device = device_->GetMTLDevice();
+      auto clone = std::make_shared<AmbreAccelStructure>();
+      clone->structure = device.newAccelerationStructure(source->size);
+      if (!clone->structure)
+        return;
+      clone->resource_id = clone->structure.gpuResourceID();
+      clone->size = source->size;
+      clone->top_level = false;
+      AmbreAccelBeginPass();
+      auto &cmd = allocator_->EncodeAccelCommand<wmtcmd_accel_copy>();
+      cmd.type = WMTAccelCommandCopy;
+      cmd.src = source->structure.handle;
+      cmd.dst = clone->structure.handle;
+      allocator_->InvalidateCurrentPass();
+      uint64_t words[1] = {clone->resource_id};
+      AmbreAccelWriteWords(Dst, words, 1);
+      device_->AmbreSetAccel(Dst, clone);
+      return;
+    }
+    if (warned++ < 10)
+      WARN("ambre-dx12: mode de copie de structure d'acceleration non pris en charge : ", (int)Mode);
+  }
