+/* Ambre : mouchard des commandes bloquées sur la carte graphique (diagnostic DirectX 12).
+   - chaque pipeline porte son nom (fonctions de sommets / pixels / calcul) ;
+   - chaque passe (encodeur) reçoit comme étiquette les pipelines qu'elle utilise ;
+   - chaque série de commandes en cours est suivie : au-delà de 3 s, ses pipelines sont écrits
+     dans le journal (« ambre-gpu: commande bloquee ») ; si macOS finit par l'interrompre, les
+     passes fautives sont nommées dans l'erreur. */
+#include <objc/runtime.h>
+static char ambre_pso_name_key;
+static __thread NSMutableArray<NSString *> *ambre_encoder_names;
+static __thread NSMutableArray<NSString *> *ambre_buffer_names;
+
+static void
+ambre_name_pso(id pso, NSString *name) {
+  if (pso && name)
+    objc_setAssociatedObject(pso, &ambre_pso_name_key, name, OBJC_ASSOCIATION_RETAIN);
+}
+#define AMBRE_NAME_PSO(pso, ...) \
+  do { @autoreleasepool { ambre_name_pso((id)(pso), [NSString stringWithFormat:__VA_ARGS__]); } } while (0)
+
+static void
+ambre_note_pso(id pso) {
+  @autoreleasepool {
+    NSString *name = pso ? objc_getAssociatedObject(pso, &ambre_pso_name_key) : nil;
+    if (!name)
+      return;
+    if (!ambre_encoder_names)
+      ambre_encoder_names = [[NSMutableArray alloc] init];
+    if (ambre_encoder_names.count < 24 && ![ambre_encoder_names containsObject:name])
+      [ambre_encoder_names addObject:name];
+  }
+}
+
+static NSMutableDictionary *ambre_inflight;
+static pthread_mutex_t ambre_inflight_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static void
+ambre_watch_start(void) {
+  static dispatch_once_t once;
+  dispatch_once(&once, ^{
+    ambre_inflight = [[NSMutableDictionary alloc] init];
+    dispatch_source_t timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0,
+                                                     dispatch_get_global_queue(QOS_CLASS_UTILITY, 0));
+    dispatch_source_set_timer(timer, dispatch_time(DISPATCH_TIME_NOW, NSEC_PER_SEC), NSEC_PER_SEC, NSEC_PER_SEC / 5);
+    dispatch_source_set_event_handler(timer, ^{
+      double now = CFAbsoluteTimeGetCurrent();
+      pthread_mutex_lock(&ambre_inflight_lock);
+      for (NSNumber *key in ambre_inflight.allKeys) {
+        NSMutableDictionary *entry = ambre_inflight[key];
+        double age = now - [entry[@"start"] doubleValue];
+        int reported = [entry[@"reported"] intValue];
+        if ((reported == 0 && age > 3) || (reported == 1 && age > 10) || (reported == 2 && age > 30)) {
+          entry[@"reported"] = @(reported + 1);
+          fprintf(stderr, "ambre-gpu: commande bloquee depuis %.0f s : %s\n", age,
+                  [entry[@"names"] UTF8String]);
+        }
+      }
+      pthread_mutex_unlock(&ambre_inflight_lock);
+    });
+    dispatch_resume(timer);
+  });
+}
