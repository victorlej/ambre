+// Agility applications load D3D12 before enumerating adapters and may look for its
+// companion module before creating a device. DXMT does not need the companion to
+// create its own devices. Keep Wine's system core available for these applications.
+static void loadAgilityCore() {
+  static const bool usesAgility = [] {
+    HMODULE application = GetModuleHandleW(nullptr);
+    return application && GetProcAddress(application, "D3D12SDKVersion") &&
+           GetProcAddress(application, "D3D12SDKPath");
+  }();
+  if (!usesAgility || !GetModuleHandleW(L"d3d12.dll"))
+    return;
+  // Called during adapter enumeration, outside DllMain. Keep the loader reference
+  // for the lifetime of the process so the module stays available to the application.
+  static const HMODULE core = LoadLibraryExW(L"d3d12core.dll", nullptr, LOAD_LIBRARY_SEARCH_SYSTEM32);
+  if (!core)
+    WARN("DXGI: Wine's D3D12 Agility companion could not be loaded");
+}
+
 extern "C" HRESULT __stdcall CreateDXGIFactory2(UINT Flags, REFIID riid,
                                                 void **ppFactory) {
+  loadAgilityCore();
   try {
