@@ -537,6 +550,48 @@ public:
       backbuffers_.push_back(reinterpret_cast<MTLD3D12Resource *>(backbuffer.ptr()));
     }
 
+    // Ambre (0037) : texture agrandie et agrandisseur MetalFX à la nouvelle taille.
+    metalfx_scaler_ = nullptr;
+    upscaled_ = {};
+    if (scale_factor > 1.0f && !backbuffers_.empty()) {
+      auto metal = device_->GetMTLDevice();
+      auto format = backbuffers_[0]->texture->pixelFormat();
+      uint32_t width = (uint32_t)(backbuffer_desc_.Width * scale_factor);
+      uint32_t height = (uint32_t)(backbuffer_desc_.Height * scale_factor);
+      WMTTextureInfo info;
+      info.type = WMTTextureType2D;
+      info.pixel_format = format;
+      info.usage = (WMTTextureUsage)(WMTTextureUsageRenderTarget | WMTTextureUsageShaderRead | WMTTextureUsageShaderWrite);
+      info.options = WMTResourceStorageModePrivate;
+      info.width = width;
+      info.height = height;
+      info.depth = 1;
+      info.mipmap_level_count = 1;
+      info.sample_count = 1;
+      info.array_length = 1;
+      upscaled_ = metal.newTexture(info);
+      WMTFXSpatialScalerInfo scaler_info;
+      scaler_info.color_format = format;
+      scaler_info.output_format = format;
+      scaler_info.input_width = (uint32_t)backbuffer_desc_.Width;
+      scaler_info.input_height = backbuffer_desc_.Height;
+      scaler_info.output_width = width;
+      scaler_info.output_height = height;
+      if (upscaled_)
+        metalfx_scaler_ = new SpatialScaler(metal, scaler_info);
+      if (!metalfx_scaler_ || !metalfx_scaler_->scaler()) {
+        ERR("ambre-dx12: agrandisseur MetalFX non cree (", backbuffer_desc_.Width, "x", backbuffer_desc_.Height, " -> ",
+            width, "x", height, ") : affichage sans agrandissement");
+        metalfx_scaler_ = nullptr;
+        upscaled_ = {};
+      } else {
+        static std::atomic<uint32_t> reported = 0;
+        if (reported++ < 5)
+          WARN("ambre-dx12: agrandissement MetalFX ", backbuffer_desc_.Width, "x", backbuffer_desc_.Height, " -> ", width,
+               "x", height);
+      }
+    }
+
     return S_OK;
   };
 
