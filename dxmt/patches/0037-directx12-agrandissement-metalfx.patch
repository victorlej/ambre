@@ -181,6 +187,13 @@ public:
       abort();
     }
 
+    if (env::getEnvVar("DXMT_METALFX_SPATIAL_SWAPCHAIN") == "1") {
+      if (pDevice->GetMTLDevice().supportsFXSpatialScaler())
+        scale_factor = std::max(Config::getInstance().getOption<float>("d3d11.metalSpatialUpscaleFactor", 2), 1.0f);
+      else
+        WARN("ambre-dx12: agrandissement MetalFX indisponible sur cette carte graphique");
+    }
+
     presenter = Rc(new Presenter(pDevice->GetMTLDevice(), layer_weak_, lib, scale_factor, desc_.SampleDesc.Count));
 
