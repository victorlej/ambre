diff --git a/src/d3d12/d3d12_command_queue.cpp b/src/d3d12/d3d12_command_queue.cpp
index e8c6c26..dca94d8 100644
--- a/src/d3d12/d3d12_command_queue.cpp
+++ b/src/d3d12/d3d12_command_queue.cpp
@@ -422,17 +422,38 @@ public:
   }
 
   HRESULT
-  Present(Presenter *presenter, ID3D12Resource *backbuffer, HANDLE hLantecyWaitable, double after) {
+  Present(
+      Presenter *presenter, ID3D12Resource *backbuffer, HANDLE hLantecyWaitable, double after, SpatialScaler *scaler,
+      WMT::Texture upscaled
+  ) {
     auto scope = StartCommitting();
     auto &cmdbuf = scope.inflight.cmdbuf;
 
     auto g = reinterpret_cast<MTLD3D12Resource *>(backbuffer);
     auto &view = g->texture->view(g->texture->fullView);
 
+    // Ambre (0037) : agrandissement MetalFX (comme EncoderType::SpatialUpscale en DirectX 11) :
+    // après le travail du jeu, avant l'affichage, l'image agrandie remplace celle du jeu.
+    WMT::Texture source = view.texture;
+    bool scaled = scaler && upscaled;
+    if (scaled) {
+      auto begin = cmdbuf.blitCommandEncoder();
+      begin.waitForFence(fence_);
+      begin.updateFence(scaler->fence());
+      begin.endEncoding();
+      cmdbuf.encodeSpatialScale(scaler->scaler(), view.texture, upscaled, scaler->fence());
+      source = upscaled;
+    }
+
+    // L'affichage attend la fin de l'agrandissement s'il y en a un, sinon le travail du jeu.
+    WMT::Fence wait_before_present = fence_;
+    if (scaled)
+      wait_before_present = scaler->fence();
+
     auto state = presenter->synchronizeLayerProperties();
     auto drawable = presenter->encodeCommands(
-        cmdbuf, view.texture, state.metadata,
-        [&](auto encoder) { encoder.waitForFence(fence_, WMTRenderStageFragment); },
+        cmdbuf, source, state.metadata,
+        [&](auto encoder) { encoder.waitForFence(wait_before_present, WMTRenderStageFragment); },
         [&](auto encoder) { encoder.updateFence(fence_, WMTRenderStageFragment); }
     );
 
