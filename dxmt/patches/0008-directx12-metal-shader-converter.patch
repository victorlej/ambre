+
+#define IR_VERSION_MAJOR 1
+#define IR_VERSION_MINOR 1
+#define IR_VERSION_PATCH 0
+
+#define IR_SUPPORTS_VERSION(major, minor, patch) \
+    ((major < IR_VERSION_MAJOR) || \
