+// Ambre : enregistre le shader DXIL pour l'étudier (mode de diagnostic, AMBRE_DXIL_DUMP = dossier).
+static void
+AmbreDumpDXIL(D3D12_SHADER_BYTECODE Bytecode) {
+  static const std::string folder = env::getEnvVar("AMBRE_DXIL_DUMP");
+  if (folder.empty())
+    return;
+  auto name = folder + "\\" + Sha1HashState::compute(Bytecode.pShaderBytecode, Bytecode.BytecodeLength).string() + ".dxil";
+  if (FILE *existing = fopen(name.c_str(), "rb")) {
+    fclose(existing);
+  } else if (FILE *file = fopen(name.c_str(), "wb")) {
+    fwrite(Bytecode.pShaderBytecode, 1, Bytecode.BytecodeLength, file);
+    fclose(file);
+    WARN("ambre-dxil: shader enregistre ", name, " (", Bytecode.BytecodeLength, " octets)");
+  }
+}
+
+bool
+MTLD3D12PipelineState::IsDXIL(D3D12_SHADER_BYTECODE Bytecode) {
+  using namespace microsoft;
+  if (!Bytecode.pShaderBytecode || !Bytecode.BytecodeLength)
+    return false;
+  CDXBCParser Parser;
+  if (FAILED(Parser.ReadDXBC(Bytecode.pShaderBytecode, Bytecode.BytecodeLength)))
+    return false;
+  return Parser.FindNextMatchingBlob(microsoft::DXBC_DXIL) != DXBC_BLOB_NOT_FOUND;
+}
+
+HRESULT
+MTLD3D12PipelineState::ConvertDXIL(
+    MTLD3D12Device *pDevice, D3D12_SHADER_BYTECODE Bytecode, ID3D12RootSignature *pRootSignature, uint32_t IntRTMask,
+    bool DualSourceBlending, WMT::Reference<WMT::Function> &Function, WMTIRReflection &Reflection
+) {
+  AmbreDumpDXIL(Bytecode);
+  WMTIRCompileInfo info{};
+  info.dxil.set(Bytecode.pShaderBytecode);
+  info.dxil_size = Bytecode.BytecodeLength;
+  info.root_signature.set(
+      pRootSignature ? static_cast<MTLD3D12RootSignature *>(pRootSignature)->GetVersionedDesc() : nullptr
+  );
+  info.int_rt_mask = IntRTMask;
+  info.dual_source_blending = DualSourceBlending;
+  char error[512];
+  auto library_handle =
+      IRConverter_newLibrary(pDevice->GetMTLDevice().handle, &info, &Reflection, error, sizeof(error));
+  if (!library_handle) {
+    ERR("ambre-dx12: shader DXIL non converti : ", error);
+    return E_FAIL;
+  }
+  WMT::Reference<WMT::Library> library(library_handle);
+  Function = library.newFunction(Reflection.entry_point);
+  if (!Function) {
+    ERR("ambre-dx12: fonction ", Reflection.entry_point, " absente du shader converti");
+    return E_FAIL;
+  }
+  static std::atomic<uint32_t> converted = 0;
+  auto count = ++converted;
+  if (count == 1 || count % 500 == 0)
+    WARN("ambre-dx12: ", count, " shaders DXIL convertis par le Metal Shader Converter");
+  return S_OK;
+}
