+  static bool
+  IsIntegerFormat(DXGI_FORMAT Format) {
+    switch (Format) {
+    case DXGI_FORMAT_R32G32B32A32_UINT: case DXGI_FORMAT_R32G32B32A32_SINT:
+    case DXGI_FORMAT_R32G32B32_UINT: case DXGI_FORMAT_R32G32B32_SINT:
+    case DXGI_FORMAT_R16G16B16A16_UINT: case DXGI_FORMAT_R16G16B16A16_SINT:
+    case DXGI_FORMAT_R32G32_UINT: case DXGI_FORMAT_R32G32_SINT:
+    case DXGI_FORMAT_R10G10B10A2_UINT:
+    case DXGI_FORMAT_R8G8B8A8_UINT: case DXGI_FORMAT_R8G8B8A8_SINT:
+    case DXGI_FORMAT_R16G16_UINT: case DXGI_FORMAT_R16G16_SINT:
+    case DXGI_FORMAT_R32_UINT: case DXGI_FORMAT_R32_SINT:
+    case DXGI_FORMAT_R8G8_UINT: case DXGI_FORMAT_R8G8_SINT:
+    case DXGI_FORMAT_R16_UINT: case DXGI_FORMAT_R16_SINT:
+    case DXGI_FORMAT_R8_UINT: case DXGI_FORMAT_R8_SINT:
+      return true;
+    default:
+      return false;
+    }
+  }
+
+  // Ambre : pipeline aux shaders DXIL convertis par le Metal Shader Converter. Sommets lus par
+  // Metal (descripteur de sommets, tampons à partir de l'index 6, attributs à partir de 11).
+  HRESULT
+  InitializeConverted(const D3D12_GRAPHICS_PIPELINE_STATE_DESC *pDesc) {
+    if (pDesc->StreamOutput.NumEntries || pDesc->GS.pShaderBytecode || pDesc->HS.pShaderBytecode ||
+        pDesc->DS.pShaderBytecode) {
+      ERR("ambre-dx12: pipeline DXIL avec GS, tessellation ou stream output : pas encore pris en charge");
+      return E_NOTIMPL;
+    }
+    if (pDesc->PS.pShaderBytecode && !IsDXIL(pDesc->PS)) {
+      ERR("ambre-dx12: shader de sommets DXIL avec shader de pixels DXBC");
+      return E_NOTIMPL;
+    }
+
+    HRESULT hr;
+    auto metal = device_->GetMTLDevice();
+    WMT::Reference<WMT::Error> err;
+
+    WMTRenderPipelineInfo info;
+    WMT::InitializeRenderPipelineInfo(info);
+    bool dual_source_blending = false;
+    if (FAILED(hr = InitializePSO(pDesc, info, dual_source_blending)))
+      return hr;
+
+    WMTIRReflection vs_reflection{}, ps_reflection{};
+    WMT::Reference<WMT::Function> vs_func, ps_func;
+    if (FAILED(hr = ConvertDXIL(device_, pDesc->VS, pDesc->pRootSignature, 0, false, vs_func, vs_reflection)))
+      return hr;
+
+    if (pDesc->PS.pShaderBytecode) {
+      uint32_t int_rt_mask = 0;
+      for (unsigned i = 0; i < pDesc->NumRenderTargets && i < 8; i++) {
+        if (IsIntegerFormat(pDesc->RTVFormats[i]))
+          int_rt_mask |= 1u << i;
+      }
+      if (FAILED(
+              hr = ConvertDXIL(
+                  device_, pDesc->PS, pDesc->pRootSignature, int_rt_mask, dual_source_blending, ps_func, ps_reflection
+              )
+          ))
+        return hr;
+    }
+
+    // Descripteur de sommets : chaque entrée du shader est rattachée à l'élément du input layout
+    // de même sémantique (« attribute0 » = ATTRIBUTE, index 0).
+    WMTVertexDescriptorInfo vertex{};
+    uint32_t append_offset[32] = {};
+    uint32_t used_slots = 0;
+    uint32_t slot_per_instance = 0, slot_step_rate[32] = {};
+    for (unsigned j = 0; j < pDesc->InputLayout.NumElements; j++) {
+      auto &element = pDesc->InputLayout.pInputElementDescs[j];
+      if (element.InputSlot >= 32)
+        continue;
+      MTL_DXGI_FORMAT_DESC format;
+      if (FAILED(MTLQueryDXGIFormat(metal, element.Format, format)) || !format.BytesPerTexel) {
+        ERR("ambre-dx12: format de sommet non pris en charge : ", element.Format);
+        return E_INVALIDARG;
+      }
+      uint32_t offset = element.AlignedByteOffset == D3D12_APPEND_ALIGNED_ELEMENT
+                            ? align(append_offset[element.InputSlot], std::min(4u, format.BytesPerTexel))
+                            : element.AlignedByteOffset;
+      append_offset[element.InputSlot] = offset + format.BytesPerTexel;
+
+      std::string semantic = element.SemanticName ? element.SemanticName : "";
+      semantic += std::to_string(element.SemanticIndex);
+      for (unsigned k = 0; k < vs_reflection.num_vertex_inputs; k++) {
+        auto &input = vs_reflection.vertex_inputs[k];
+        if (strcasecmp(input.name, semantic.c_str()) != 0)
+          continue;
+        auto &attribute = vertex.attributes[vertex.num_attributes++];
+        attribute.dxgi_format = element.Format;
+        attribute.offset = offset;
+        attribute.buffer_index = 6 + element.InputSlot;
+        attribute.attribute_index = 11 + input.attribute_index;
+        used_slots |= 1u << element.InputSlot;
+        if (element.InputSlotClass == D3D12_INPUT_CLASSIFICATION_PER_INSTANCE_DATA) {
+          slot_per_instance |= 1u << element.InputSlot;
+          slot_step_rate[element.InputSlot] = element.InstanceDataStepRate;
+        }
+        break;
+      }
+    }
+    if (vertex.num_attributes != vs_reflection.num_vertex_inputs) {
+      WARN(
+          "ambre-dx12: ", vs_reflection.num_vertex_inputs - vertex.num_attributes,
+          " entree(s) du shader de sommets sans element dans le input layout"
+      );
+    }
+    for (unsigned slot = 0; slot < 32; slot++) {
+      if (!(used_slots & (1u << slot)))
+        continue;
+      auto &layout = vertex.layouts[vertex.num_layouts++];
+      layout.buffer_index = 6 + slot;
+      layout.per_instance = (slot_per_instance >> slot) & 1;
+      layout.step_rate = slot_step_rate[slot];
+    }
+    slot_mask = used_slots;
+    if (vertex.num_attributes)
+      info.vertex_descriptor.set(&vertex);
+
+    info.vertex_function = vs_func.handle;
+    info.fragment_function = ps_func.handle;
+    pso = metal.newRenderPipelineState(info, err);
+    if (!pso) {
+      ERR("ambre-dx12: pipeline de rendu refuse par Metal : ", err.description().getUTF8String());
+      return E_FAIL;
+    }
+
+    InitializeDSSO(pDesc);
+    InitializeRasterizerState(pDesc);
+    IsConvertedPipelineState = 1;
+    return S_OK;
+  }
