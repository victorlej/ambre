+/* Ambre : Metal Shader Converter d'Apple (DXIL -> Metal), chargé à la demande.
+   Chemin : AMBRE_IRCONVERTER, sinon libmetalirconverter.dylib à côté de winemetal.so. */
+#include "metal_irconverter/metal_irconverter.h"
+#include <pthread.h>
+#include <libgen.h>
+
+#define AMBRE_IR_FUNCS(X)                                                                                              \
+  X(IRCompilerCreate) X(IRCompilerDestroy) X(IRCompilerSetMinimumGPUFamily) X(IRCompilerSetMinimumDeploymentTarget)   \
+  X(IRCompilerSetGlobalRootSignature) X(IRCompilerSetIntRTMask) X(IRCompilerSetDualSourceBlendingConfiguration)       \
+  X(IRCompilerAllocCompileAndLink) X(IRRootSignatureCreateFromDescriptor) X(IRRootSignatureDestroy)                    \
+  X(IRObjectCreateFromDXIL) X(IRObjectDestroy) X(IRObjectGetMetalIRShaderStage) X(IRObjectGetMetalLibBinary)           \
+  X(IRObjectGetReflection) X(IRMetalLibBinaryCreate) X(IRMetalLibBinaryDestroy) X(IRMetalLibGetBytecode)              \
+  X(IRMetalLibGetBytecodeSize) X(IRShaderReflectionCreate) X(IRShaderReflectionDestroy)                               \
+  X(IRShaderReflectionGetEntryPointFunctionName) X(IRShaderReflectionCopyComputeInfo)                                 \
+  X(IRShaderReflectionCopyVertexInfo) X(IRShaderReflectionReleaseComputeInfo) X(IRShaderReflectionReleaseVertexInfo)  \
+  X(IRErrorGetCode) X(IRErrorDestroy)
+
+static struct {
+#define X(name) __typeof__(&name) name;
+  AMBRE_IR_FUNCS(X)
+#undef X
+} ambre_ir;
+static pthread_once_t ambre_ir_once = PTHREAD_ONCE_INIT;
+static bool ambre_ir_loaded = false;
+static pthread_mutex_t ambre_ir_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static void
+ambre_ir_load(void) {
+  char path[PATH_MAX];
+  const char *env = getenv("AMBRE_IRCONVERTER");
+  if (env && *env) {
+    snprintf(path, sizeof(path), "%s", env);
+  } else {
+    Dl_info info;
+    char self[PATH_MAX];
+    if (!dladdr((void *)&ambre_ir_load, &info) || !info.dli_fname)
+      return;
+    snprintf(self, sizeof(self), "%s", info.dli_fname);
+    snprintf(path, sizeof(path), "%s/libmetalirconverter.dylib", dirname(self));
+  }
+  void *lib = dlopen(path, RTLD_NOW | RTLD_LOCAL);
+  if (!lib) {
+    fprintf(stderr, "ambre-dx12: Metal Shader Converter introuvable (%s) : %s\n", path, dlerror());
+    return;
+  }
+#define X(name)                                                                                                        \
+  if (!(ambre_ir.name = (__typeof__(&name))dlsym(lib, #name))) {                                                       \
+    fprintf(stderr, "ambre-dx12: fonction absente du Metal Shader Converter : %s\n", #name);                          \
+    return;                                                                                                            \
+  }
+  AMBRE_IR_FUNCS(X)
+#undef X
+  ambre_ir_loaded = true;
+  fprintf(stderr, "ambre-dx12: Metal Shader Converter charge (%s)\n", path);
+}
+
+static NTSTATUS
+_IRConverter_newLibrary(void *obj) {
+  struct unixcall_irconverter_newlibrary *params = obj;
+  const struct WMTIRCompileInfo *info = params->info.ptr;
+  struct WMTIRReflection *reflection = params->reflection.ptr;
+  char *error = params->error.ptr;
+  size_t error_size = params->error_size;
+  params->ret_library = 0;
+
+  pthread_once(&ambre_ir_once, ambre_ir_load);
+  if (!ambre_ir_loaded) {
+    if (error && error_size)
+      snprintf(error, error_size, "Metal Shader Converter indisponible");
+    return STATUS_SUCCESS;
+  }
+
+  IRCompiler *compiler = ambre_ir.IRCompilerCreate();
+  ambre_ir.IRCompilerSetMinimumGPUFamily(compiler, IRGPUFamilyApple7);
+  ambre_ir.IRCompilerSetMinimumDeploymentTarget(compiler, IROperatingSystem_macOS, "14.0.0");
+  if (info->int_rt_mask)
+    ambre_ir.IRCompilerSetIntRTMask(compiler, (uint8_t)info->int_rt_mask);
+  ambre_ir.IRCompilerSetDualSourceBlendingConfiguration(
+      compiler, info->dual_source_blending ? IRDualSourceBlendingConfigurationForceEnabled
+                                           : IRDualSourceBlendingConfigurationForceDisabled
+  );
+
+  IRError *ir_error = NULL;
+  IRRootSignature *root_signature = NULL;
+  IRObject *input = NULL, *output = NULL;
+  IRMetalLibBinary *metallib = NULL;
+  IRShaderReflection *ir_reflection = NULL;
+
+  if (info->root_signature.ptr) {
+    root_signature = ambre_ir.IRRootSignatureCreateFromDescriptor(info->root_signature.ptr, &ir_error);
+    if (!root_signature) {
+      if (error && error_size)
+        snprintf(error, error_size, "root signature refusee (code %u)", ir_error ? ambre_ir.IRErrorGetCode(ir_error) : 0);
+      goto out;
+    }
+    ambre_ir.IRCompilerSetGlobalRootSignature(compiler, root_signature);
+  }
+
+  input = ambre_ir.IRObjectCreateFromDXIL(info->dxil.ptr, info->dxil_size, IRBytecodeOwnershipNone);
+  /* Le convertisseur n'est pas garanti sûr entre fils : une conversion à la fois. */
+  pthread_mutex_lock(&ambre_ir_lock);
+  output = ambre_ir.IRCompilerAllocCompileAndLink(compiler, NULL, input, &ir_error);
+  pthread_mutex_unlock(&ambre_ir_lock);
+  if (!output) {
+    if (error && error_size)
+      snprintf(error, error_size, "conversion refusee (code %u)", ir_error ? ambre_ir.IRErrorGetCode(ir_error) : 0);
+    goto out;
+  }
+
+  IRShaderStage stage = ambre_ir.IRObjectGetMetalIRShaderStage(output);
+  metallib = ambre_ir.IRMetalLibBinaryCreate();
+  if (!ambre_ir.IRObjectGetMetalLibBinary(output, stage, metallib)) {
+    if (error && error_size)
+      snprintf(error, error_size, "pas de metallib pour l'etape %d", stage);
+    goto out;
+  }
+  size_t size = ambre_ir.IRMetalLibGetBytecodeSize(metallib);
+  uint8_t *bytes = malloc(size);
+  ambre_ir.IRMetalLibGetBytecode(metallib, bytes);
+  dispatch_data_t data = dispatch_data_create(bytes, size, NULL, DISPATCH_DATA_DESTRUCTOR_FREE);
+  NSError *ns_error = NULL;
+  id<MTLLibrary> library = [(id<MTLDevice>)params->device newLibraryWithData:data error:&ns_error];
+  dispatch_release(data);
+  if (!library) {
+    if (error && error_size)
+      snprintf(error, error_size, "bibliotheque Metal refusee : %s",
+               ns_error ? [[ns_error localizedDescription] UTF8String] : "?");
+    goto out;
+  }
+
+  if (reflection) {
+    memset(reflection, 0, sizeof(*reflection));
+    reflection->stage = stage;
+    ir_reflection = ambre_ir.IRShaderReflectionCreate();
+    if (ambre_ir.IRObjectGetReflection(output, stage, ir_reflection)) {
+      const char *entry = ambre_ir.IRShaderReflectionGetEntryPointFunctionName(ir_reflection);
+      snprintf(reflection->entry_point, sizeof(reflection->entry_point), "%s", entry ? entry : "");
+      if (stage == IRShaderStageCompute) {
+        IRVersionedCSInfo cs;
+        if (ambre_ir.IRShaderReflectionCopyComputeInfo(ir_reflection, IRReflectionVersion_1_0, &cs)) {
+          for (unsigned i = 0; i < 3; i++)
+            reflection->threadgroup_size[i] = cs.info_1_0.tg_size[i];
+          ambre_ir.IRShaderReflectionReleaseComputeInfo(&cs);
+        }
+      } else if (stage == IRShaderStageVertex) {
+        IRVersionedVSInfo vs;
+        if (ambre_ir.IRShaderReflectionCopyVertexInfo(ir_reflection, IRReflectionVersion_1_0, &vs)) {
+          reflection->needs_draw_params = vs.info_1_0.needs_draw_params;
+          for (size_t i = 0; i < vs.info_1_0.num_vertex_inputs && i < 32; i++) {
+            snprintf(reflection->vertex_inputs[i].name, sizeof(reflection->vertex_inputs[i].name), "%s",
+                     vs.info_1_0.vertex_inputs[i].name ? vs.info_1_0.vertex_inputs[i].name : "");
+            reflection->vertex_inputs[i].attribute_index = vs.info_1_0.vertex_inputs[i].attributeIndex;
+            reflection->num_vertex_inputs = i + 1;
+          }
+          ambre_ir.IRShaderReflectionReleaseVertexInfo(&vs);
+        }
+      }
+    }
+  }
+  params->ret_library = (obj_handle_t)library;
+
+out:
+  if (ir_reflection)
+    ambre_ir.IRShaderReflectionDestroy(ir_reflection);
+  if (metallib)
+    ambre_ir.IRMetalLibBinaryDestroy(metallib);
+  if (output)
+    ambre_ir.IRObjectDestroy(output);
+  if (input)
+    ambre_ir.IRObjectDestroy(input);
+  if (root_signature)
+    ambre_ir.IRRootSignatureDestroy(root_signature);
+  if (ir_error)
+    ambre_ir.IRErrorDestroy(ir_error);
+  ambre_ir.IRCompilerDestroy(compiler);
+  return STATUS_SUCCESS;
+}
+
+static NTSTATUS
+_IRConverter_unsupported(void *obj) {
+  return STATUS_NOT_IMPLEMENTED;
+}
