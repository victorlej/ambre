+    Dl_info info;
+    char self[PATH_MAX];
+    if (!dladdr((void *)&ambre_dxil_load, &info) || !info.dli_fname)
+      return;
+    snprintf(self, sizeof(self), "%s", info.dli_fname);
+    snprintf(path, sizeof(path), "%s/libambre_dxil.dylib", dirname(self));
+  }
+  void *lib = dlopen(path, RTLD_NOW | RTLD_LOCAL);
+  if (!lib) {
+    fprintf(stderr, "ambre-dx12: module de conversion DXIL introuvable (%s)\n", path);
+    return;
+  }
+  ambre_dxil_convert = (ambre_dxil_convert_fn)dlsym(lib, "ambre_dxil_convert");
+  ambre_dxil_free = (ambre_dxil_free_fn)dlsym(lib, "ambre_dxil_free");
+  if (!ambre_dxil_convert || !ambre_dxil_free) {
+    ambre_dxil_convert = NULL;
+    fprintf(stderr, "ambre-dx12: module de conversion DXIL incomplet (%s)\n", path);
+  }
+}
+
+static NTSTATUS
+_IRConverter_newLibrary(void *obj) {
+  struct unixcall_irconverter_newlibrary *params = obj;
+  const struct WMTIRCompileInfo *info = params->info.ptr;
+  struct WMTIRReflection *reflection = params->reflection.ptr;
+  char *error = params->error.ptr;
+  size_t error_size = params->error_size;
+  char fallback[256];
+  if (!error || !error_size) {
+    error = fallback;
+    error_size = sizeof(fallback);
+  }
+  params->ret_library = 0;
+
+  pthread_once(&ambre_dxil_once, ambre_dxil_load);
+  if (!ambre_dxil_convert) {
+    snprintf(error, error_size, "pas de module de conversion DXIL");
+    return STATUS_SUCCESS;
+  }
+  struct WMTIRReflection local_reflection;
+  void *bytes = NULL;
+  size_t size = 0;
+  if (ambre_dxil_convert(info, reflection ? reflection : &local_reflection, &bytes, &size, error, error_size))
+    return STATUS_SUCCESS;
+
+  dispatch_data_t data = dispatch_data_create(bytes, size, NULL, DISPATCH_DATA_DESTRUCTOR_DEFAULT);
+  NSError *ns_error = NULL;
+  id<MTLLibrary> library = [(id<MTLDevice>)params->device newLibraryWithData:data error:&ns_error];
+  dispatch_release(data);
+  ambre_dxil_free(bytes);
+  if (!library) {
+    snprintf(error, error_size, "bibliotheque Metal refusee : %s",
+             ns_error ? [[ns_error localizedDescription] UTF8String] : "?");
+    return STATUS_SUCCESS;
+  }
+  params->ret_library = (obj_handle_t)library;
+  return STATUS_SUCCESS;
+}
+
+static NTSTATUS
+_IRConverter_unsupported(void *obj) {
+  return (NTSTATUS)0xC0000002; /* STATUS_NOT_IMPLEMENTED */
+}
