+WINEMETAL_API obj_handle_t
+IRConverter_newLibrary(
+    obj_handle_t device, const struct WMTIRCompileInfo *info, struct WMTIRReflection *reflection, char *error,
+    uint64_t error_size
+) {
+  struct unixcall_irconverter_newlibrary params;
+  params.device = device;
+  WMT_MEMPTR_SET(params.info, info);
+  WMT_MEMPTR_SET(params.reflection, reflection);
+  WMT_MEMPTR_SET(params.error, error);
+  params.error_size = error_size;
+  params.ret_library = 0;
+  if (error && error_size)
+    error[0] = 0;
+  if (UNIX_CALL(146, &params))
+    return 0;
+  return params.ret_library;
+}
