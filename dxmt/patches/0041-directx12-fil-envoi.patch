+  /* Ambre (0041) : fil d'envoi. Le jeu ne traduit plus ses listes en commandes Metal lui-même
+     (Elden Ring après 0040 : 400 à 580 ms/s du fil du jeu, puce graphique encore à ~75 %) : chaque
+     envoi (listes, Signal, Wait, présentation) est mis dans une file traitée dans l'ordre par un fil
+     à part. Le jeu attend s'il a plus de deux images d'avance. AMBRE_DX12_ASYNC=0 : comme avant. */
+  bool async_ = env::getEnvVar("AMBRE_DX12_ASYNC") != "0";
+  dxmt::mutex submit_mutex_;
+  std::deque<std::function<void()>> submit_tasks_;
+  std::atomic<uint64_t> submit_pushed_{0}, submit_done_{0}, submit_presents_{0};
+  std::atomic<bool> submit_stop_{false};
+  std::unique_ptr<dxmt::thread> submit_thread_;
+
+  void
+  Submit(std::function<void()> task, bool present = false) {
+    if (!async_) {
+      task();
+      return;
+    }
+    if (present) {
+      // Pas plus de deux images d'avance sur le fil d'envoi.
+      uint64_t pending;
+      while ((pending = submit_presents_.load(std::memory_order_acquire)) >= 2)
+        submit_presents_.wait(pending, std::memory_order_acquire);
+      submit_presents_.fetch_add(1, std::memory_order_acq_rel);
+      task = [task = std::move(task), this]() {
+        task();
+        submit_presents_.fetch_sub(1, std::memory_order_acq_rel);
+        submit_presents_.notify_all();
+      };
+    }
+    {
+      std::lock_guard<dxmt::mutex> lock(submit_mutex_);
+      submit_tasks_.push_back(std::move(task));
+    }
+    submit_pushed_.fetch_add(1, std::memory_order_release);
+    submit_pushed_.notify_one();
+  }
+
+  void
+  SubmitThread() {
+    env::setThreadName("ambre-d3d12-submit");
+    uint64_t seen = 0;
+    for (;;) {
+      submit_pushed_.wait(seen, std::memory_order_acquire);
+      seen = submit_pushed_.load(std::memory_order_acquire);
+      for (;;) {
+        std::function<void()> task;
+        {
+          std::lock_guard<dxmt::mutex> lock(submit_mutex_);
+          if (submit_tasks_.empty())
+            break;
+          task = std::move(submit_tasks_.front());
+          submit_tasks_.pop_front();
+        }
+        task();
+        submit_done_.fetch_add(1, std::memory_order_release);
+      }
+      if (submit_stop_.load(std::memory_order_acquire))
+        return;
+    }
+  }
