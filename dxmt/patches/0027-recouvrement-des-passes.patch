   void STDMETHODCALLTYPE ResourceBarrier(UINT Count, const D3D12_RESOURCE_BARRIER *barriers) {
-    // TODO: in the initial implementation, we force synchronize everything and ignore barriers (which can be used as
-    // optimization hints later)
+    // Tout reste synchronisé (un encodeur attend le précédent). Ambre (0027) : une barrière qui
+    // rend une ressource lisible ailleurs que dans les pixel shaders (sommets, constantes, index,
+    // arguments indirects, calcul, UAV, alias) force l'encodeur suivant à attendre dès les sommets.
+    constexpr UINT pixel_only = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE | D3D12_RESOURCE_STATE_RENDER_TARGET |
+                                D3D12_RESOURCE_STATE_DEPTH_WRITE | D3D12_RESOURCE_STATE_DEPTH_READ |
+                                D3D12_RESOURCE_STATE_COPY_DEST | D3D12_RESOURCE_STATE_COPY_SOURCE |
+                                D3D12_RESOURCE_STATE_RESOLVE_DEST | D3D12_RESOURCE_STATE_RESOLVE_SOURCE;
+    for (UINT i = 0; i < Count && barriers; i++) {
+      auto &b = barriers[i];
+      if (b.Type != D3D12_RESOURCE_BARRIER_TYPE_TRANSITION || !b.Transition.StateAfter ||
+          (b.Transition.StateAfter & ~pixel_only)) {
+        allocator_->ambre_barrier_pending = true;
+        break;
+      }
+    }
   };
 
