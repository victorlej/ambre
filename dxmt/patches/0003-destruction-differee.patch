+/**
+Ambre : destruction différée, comme Direct3D 11 et DXVK (qui gardent un objet tant que le GPU
+s'en sert). Des jeux libèrent un objet une fois de trop et l'utilisent juste après (Skyrim SE :
+« Pure virtual function called ») ; détruit une seconde plus tard, l'objet est encore intact.
+Tout est détruit tout de suite pendant la destruction d'un périphérique (les objets ne doivent
+pas lui survivre).
+*/
+class DeferredDestruction {
+public:
+  static void push(void *object, void (*destroy)(void *)) {
+    auto &self = instance();
+    std::vector<Entry> ready;
+    {
+      std::lock_guard<std::mutex> lock(self.mutex_);
+      if (self.immediate_ == 0) {
+        uint64_t now = GetTickCount64();
+        self.queue_.push_back({now, object, destroy});
+        while (!self.queue_.empty() &&
+               (now - self.queue_.front().time >= kDelayMs || self.queue_.size() > kMaxPending)) {
+          ready.push_back(self.queue_.front());
+          self.queue_.pop_front();
+        }
+      } else {
+        ready.push_back({0, object, destroy});
+      }
+    }
+    // Hors du verrou : un destructeur peut libérer d'autres objets.
+    for (auto &entry : ready)
+      entry.destroy(entry.object);
+  }
+
+  /* Destruction d'un périphérique : tout de suite, jusqu'à endDeviceDestruction(). */
+  static void beginDeviceDestruction() {
+    auto &self = instance();
+    std::deque<Entry> pending;
+    {
+      std::lock_guard<std::mutex> lock(self.mutex_);
+      self.immediate_++;
+      pending.swap(self.queue_);
+    }
+    for (auto &entry : pending)
+      entry.destroy(entry.object);
+  }
+
+  static void endDeviceDestruction() {
+    auto &self = instance();
+    std::lock_guard<std::mutex> lock(self.mutex_);
+    self.immediate_--;
+  }
+
+private:
+  struct Entry {
+    uint64_t time;
+    void *object;
+    void (*destroy)(void *);
+  };
+  static constexpr uint64_t kDelayMs = 1000;
+  static constexpr size_t kMaxPending = 16384;
+
+  static DeferredDestruction &instance() {
+    static DeferredDestruction self;
+    return self;
+  }
+
+  std::mutex mutex_;
+  std::deque<Entry> queue_;
+  uint32_t immediate_ = 0;
+};
+
