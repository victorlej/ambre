 #include "dxmt_info.hpp"
 #include "dxmt_presenter.hpp"
 #include <atomic>
+#include <mutex>
+
+namespace {
+/* Ambre : prise d'extension à chaque image présentée. Si la variable
+   AMBRE_PRESENT_PLUGIN_DIR désigne un dossier, DXMT y charge ambre_present64.dll (ou
+   ambre_present32.dll) et appelle sa fonction « ambre_present » à chaque Present. Sans cette
+   variable, rien ne change. */
+void AmbrePresentHook() {
+  static std::once_flag once;
+  static void (*hook)(void) = nullptr;
+  std::call_once(once, [] {
+    char dir[MAX_PATH];
+    DWORD length = GetEnvironmentVariableA("AMBRE_PRESENT_PLUGIN_DIR", dir, sizeof(dir));
+    if (!length || length >= sizeof(dir) - 32)
+      return;
+    std::string path(dir, length);
+    if (path.back() != '\\' && path.back() != '/')
+      path += '\\';
+    path += sizeof(void *) == 8 ? "ambre_present64.dll" : "ambre_present32.dll";
+    if (HMODULE module = LoadLibraryA(path.c_str()))
+      hook = reinterpret_cast<void (*)(void)>(reinterpret_cast<void *>(GetProcAddress(module, "ambre_present")));
+  });
+  if (hook)
+    hook();
+}
+} // namespace
 #include <cfloat>
 #include <format>
 
