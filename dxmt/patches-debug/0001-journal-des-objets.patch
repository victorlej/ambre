 #pragma once
 
 #include <atomic>
+#include <cstdarg>
+#include <cstdio>
+#include <typeinfo>
 #include "unknwn.h"
 #include "../util_likely.hpp"
 
+/* Ambre (diagnostic) : journal par le canal de Wine (__wine_dbg_output), comme le Logger de
+   DXMT ; la sortie d'erreur Windows n'existe pas pour un jeu lancé par Steam. */
+static inline void ambre_dxmt_log(const char *format, ...) {
+  char line[512];
+  va_list args;
+  va_start(args, format);
+  vsnprintf(line, sizeof(line), format, args);
+  va_end(args);
+  typedef int(__cdecl * wine_dbg_output_t)(const char *);
+  static wine_dbg_output_t output = (wine_dbg_output_t)(void *)GetProcAddress(GetModuleHandleA("ntdll.dll"), "__wine_dbg_output");
+  if (output) output(line); else fputs(line, stderr);
+}
+
+/* « module+décalage » d'une adresse de code (jeu, DLL), lisible sans connaître les adresses de chargement. */
+struct ambre_dxmt_where {
+  char text[160];
+  explicit ambre_dxmt_where(void *address) {
+    HMODULE module = nullptr;
+    char path[MAX_PATH] = "?";
+    if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                           (LPCSTR)address, &module) && module)
+      GetModuleFileNameA(module, path, sizeof(path));
+    const char *name = path;
+    for (const char *c = path; *c; c++)
+      if (*c == '\\' || *c == '/') name = c + 1;
+    snprintf(text, sizeof(text), "%s+0x%llx", name,
+             (unsigned long long)((char *)address - (char *)module));
+  }
+};
